    'disk_ext.await': {
        height: 0.5,
        info: '向设备发出的丢弃/刷新请求被服务的平均时间。这包括请求在队列中花费的时间和为它们提供服务所花费的时间。'
    },

    'disk.space': {
        info: '磁盘空间利用率。为 root 保留的空间由系统自动保留，以防止 root 用户空间不足。'
    },
    'disk.inodes': {
        info: 'Inodes（或索引节点）是文件系统对象（例如文件和目录）。在许多类型的文件系统实现中，inodes 的最大数量在文件系统创建时是固定的，限制了文件系统可以容纳的最大文件数。设备可能会耗尽 inodes。当发生这种情况时，即使可能有可用的空闲空间，也无法在设备上创建新文件。'
    },

    'disk.bcache_hit_ratio': {
        info: '<p><b>Bcache（块缓存）</b>是 Linux 内核块层中的缓存，'+
        '用于访问辅助存储设备。'+
        '它允许一个或多个快速存储设备（如基于闪存的固态硬盘 (SSD)）'+
        '充当一个或多个较慢存储设备（如硬盘驱动器 (HDD)）的缓存。</p>'+
        '<p>直接从块缓存满足的数据请求百分比。'+
        '命中和未命中按 bcache 看到的每个单独 IO 计数。'+
        '部分命中计为未命中。</p>'
    },
    'disk.bcache_rates': {
        info: '限流速率。'+
        '为避免拥塞，bcache 跟踪到缓存设备的延迟，如果延迟超过阈值则逐渐限流。' +
        '如果回写百分比非零，bcache 会尝试通过'+
        '限流后台回写并使用 PD 控制器平滑调整速率来保持大约此百分比的缓存为脏。'
    },
    'disk.bcache_size': {
        info: '此后备设备在缓存中的脏数据量。'
    },
    'disk.bcache_usage': {
        info: '不包含脏数据且可能用于回写的缓存设备百分比。'
    },
    'disk.bcache_cache_read_races': {
        info: '<b>读取竞争</b>发生在从缓存读取数据时桶被重用和失效时。'+
        '发生这种情况时，数据将从后备设备重新读取。'+
        '<b>IO 错误</b>按半衰期衰减。'+
        '如果衰减计数达到限制，脏数据将被写出并禁用缓存。'
    },
    'disk.bcache': {
        info: '命中和未命中按 bcache 看到的每个单独 IO 计数；部分命中计为未命中。'+
        '当由于缓存未命中而要将数据插入缓存时发生冲突，'+
        '但与写入竞争且数据已存在。'+
        '缓存未命中读取向上舍入到预读大小，但不重叠现有缓存条目。'
    },
    'disk.bcache_bypass': {
        info: '旨在跳过缓存的 IO 的命中和未命中。'
    },
    'disk.bcache_cache_alloc': {
        info: '<p>工作集大小。</p>'+
        '<p><b>Unused</b> 是缓存中不包含任何数据的百分比。 '+
        '<b>Dirty</b> 是在缓存中已修改但尚未写入永久存储的数据。 '+
        '<b>Clean</b> 数据与永久存储上存储的数据匹配。 '+
        '<b>Metadata</b> 是 bcache 的元数据开销。</p>'
    },

