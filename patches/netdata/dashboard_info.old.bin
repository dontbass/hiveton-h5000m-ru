    },

    'web_log.squid_clients': {
        info: '在每次数据收集迭代中访问 squid 的唯一客户端 IP。如果数据收集是<b>每秒一次</b>，此图表显示<b>每秒唯一客户端 IP</b>。'
    },

    'web_log.squid_clients_all': {
        info: '自上次重启 netdata 以来访问 squid 的唯一客户端 IP。此插件在内存中保留所有访问过服务器的唯一 IP。在非常繁忙的 squid 服务器上（数百万个唯一 IP），您可能希望禁用此图表（检查 <a href="https://github.com/netdata/go.d.plugin/blob/master/config/go.d/web_log.conf" target="_blank"><code>/etc/netdata/go.d/web_log.conf</code></a>）。'
    },

    'web_log.squid_transport_methods': {
        info: '按传输方法细分：<code>TCP</code> 是 HTTP 端口（通常是 3128）上的请求，' +
            '<code>UDP</code> 是 ICP 端口（通常是 3130）或 HTCP 端口（通常是 4128）上的请求。 ' +
            '如果使用 log_icp_queries 选项禁用了 ICP 日志记录，则不会记录 ICP 回复。 ' +
            '<code>NONE</code> 用于表示 squid 传递了异常响应或根本没有响应。 ' +
            '在 cachemgr 请求和错误中可见，通常是在事务被分类为上述结果之一之前失败时。 ' +
            '在对 <code>CONNECT</code> 请求的响应中也可见。'
    },

    'web_log.squid_code': {
        info: '这些是组合的 squid 结果状态代码。以下图表中给出了每个组件的细分。 ' +
            '查看<a href="http://wiki.squid-cache.org/SquidFaq/SquidLogs" target="_blank">关于它们的 squid 文档</a>。'
    },

    'web_log.squid_handling_opts': {
        info: '这些标签是可选的，描述了为什么执行特定处理或请求来自何处。 ' +
            '<code>CLIENT</code> 表示客户端请求设置了影响响应的限制。通常在客户端发出 <b>no-cache</b> 或类似的缓存控制命令以及请求时可见。因此，缓存必须验证对象。' +
            '<code>IMS</code> 表示客户端发送了重新验证（条件）请求。 ' +
            '<code>ASYNC</code>，当请求由 Squid 内部生成时使用。通常这是用于缓存信息交换的后台获取、来自 stale-while-revalidate 缓存控制的后台重新验证，或正在加载的 ESI 子对象。 ' +
            '<code>SWAPFAIL</code> 当对象被认为在缓存中，但无法访问时分配。从服务器请求了新副本。 ' +
            '<code>REFRESH</code> 当向服务器发送重新验证（条件）请求时。 ' +
            '<code>SHARED</code> 当此请求通过折叠转发与现有事务组合时。注意：现有请求未标记为 SHARED。 ' +
            '<code>REPLY</code> 当在来自服务器或对等方的 HTTP 回复中请求特定处理时。通常在 DENIED 上可见，因为 http_reply_access ACL 阻止将服务器响应对象传递给客户端。'
    },

    'web_log.squid_object_types': {
        info: '这些标签是可选的，描述了产生的对象类型。 ' +
            '<code>NEGATIVE</code> 仅在 HIT 响应上可见，表示响应是缓存的错误响应。例如 <b>404 not found</b>。 ' +
            '<code>STALE</code> 表示对象已缓存并以陈旧状态提供。这通常由 stale-while-revalidate 或 stale-if-error 缓存控制引起。 ' +
            '<code>OFFLINE</code> 当在 offline_mode 期间从缓存中检索请求的对象时。离线模式从不验证任何对象。 ' +
            '<code>INVALID</code> 当收到无效请求时。传递了指示问题所在的错误响应。 ' +
            '<code>FAIL</code> 仅在 <code>REFRESH</code> 上可见，以表明重新验证请求失败。响应对象可能是服务器提供的网络错误或正在重新验证的陈旧对象，具体取决于 stale-if-error 缓存控制。 ' +
            '<code>MODIFIED</code> 仅在 <code>REFRESH</code> 响应上可见，以表明重新验证产生了新的修改对象。 ' +
            '<code>UNMODIFIED</code> 仅在 <code>REFRESH</code> 响应上可见，以表明重新验证产生了 <b>304</b>（未修改）状态，该状态已转发给客户端。 ' +
            '<code>REDIRECT</code> 当 squid 为此请求生成 HTTP 重定向响应时。'
    },

    'web_log.squid_cache_events': {
        info: '这些标签是可选的，描述响应是从缓存、网络还是其他方式加载的。 ' +
            '<code>HIT</code> 当传递的响应对象是本地缓存对象时。 ' +
            '<code>MEM</code> 当响应对象来自内存缓存，避免磁盘访问时。仅在 HIT 响应上可见。 ' +
            '<code>MISS</code> 当传递的响应对象是网络响应对象时。 ' +
            '<code>DENIED</code> 当请求被访问控制拒绝时。 ' +
            '<code>NOFETCH</code> ICP 特定类型，表示服务处于活动状态，但不用于此请求（在"-Y"启动期间发送，或在频繁失败期间，仅命中模式的缓存将返回 UDP_HIT 或 UDP_MISS_NOFETCH。因此邻居将仅获取命中）。 ' +
            '<code>TUNNEL</code> 当为此事务建立二进制隧道时。'
    },

    'web_log.squid_transport_errors': {
        info: '这些标签是可选的，描述响应传递期间发生的一些错误条件（如果有）。 ' +
            '<code>ABORTED</code> 当由于连接中止（通常由客户端）而未完成响应时。 ' +
            '<code>TIMEOUT</code>，当由于连接超时而未完成响应时。'
    },

     // ------------------------------------------------------------------------
    // go web_log

    'web_log.type_requests': {
        info: '按类型分类的 Web 服务器响应。<code>success</code> 包括 <b>1xx</b>、<b>2xx</b>、<b>304</b> 和 <b>401</b>，<code>error</code> 包括 <b>5xx</b>，<code>redirect</code> 包括 <b>3xx</b> 但不包括 <b>304</b>，<code>bad</code> 包括 <b>4xx</b> 但不包括 <b>401</b>，<code>other</code> 是所有其他响应。',
        mainheads: [
            function (os, id) {
                void (os);
                return '<div data-netdata="' + id + '"'
                    + ' data-dimensions="success"'
                    + ' data-chart-library="gauge"'
                    + ' data-title="Successful"'
                    + ' data-units="requests/s"'
                    + ' data-gauge-adjust="width"'
                    + ' data-width="12%"'
                    + ' data-before="0"'
                    + ' data-after="-CHART_DURATION"'
                    + ' data-points="CHART_DURATION"'
                    + ' data-common-max="' + id + '"'
                    + ' data-colors="' + NETDATA.colors[0] + '"'
                    + ' data-decimal-digits="0"'
                    + ' role="application"></div>';
            },

            function (os, id) {
                void (os);
                return '<div data-netdata="' + id + '"'
                    + ' data-dimensions="redirect"'
                    + ' data-chart-library="gauge"'
                    + ' data-title="Redirects"'
                    + ' data-units="requests/s"'
                    + ' data-gauge-adjust="width"'
                    + ' data-width="12%"'
                    + ' data-before="0"'
                    + ' data-after="-CHART_DURATION"'
                    + ' data-points="CHART_DURATION"'
                    + ' data-common-max="' + id + '"'
                    + ' data-colors="' + NETDATA.colors[2] + '"'
                    + ' data-decimal-digits="0"'
                    + ' role="application"></div>';
            },

            function (os, id) {
                void (os);
                return '<div data-netdata="' + id + '"'
                    + ' data-dimensions="bad"'
                    + ' data-chart-library="gauge"'
                    + ' data-title="Bad Requests"'
                    + ' data-units="requests/s"'
                    + ' data-gauge-adjust="width"'
                    + ' data-width="12%"'
                    + ' data-before="0"'
                    + ' data-after="-CHART_DURATION"'
                    + ' data-points="CHART_DURATION"'
                    + ' data-common-max="' + id + '"'
                    + ' data-colors="' + NETDATA.colors[3] + '"'
                    + ' data-decimal-digits="0"'
                    + ' role="application"></div>';
            },

            function (os, id) {
                void (os);
                return '<div data-netdata="' + id + '"'
                    + ' data-dimensions="error"'
                    + ' data-chart-library="gauge"'
                    + ' data-title="Server Errors"'
                    + ' data-units="requests/s"'
                    + ' data-gauge-adjust="width"'
                    + ' data-width="12%"'
                    + ' data-before="0"'
                    + ' data-after="-CHART_DURATION"'
                    + ' data-points="CHART_DURATION"'
                    + ' data-common-max="' + id + '"'
                    + ' data-colors="' + NETDATA.colors[1] + '"'
                    + ' data-decimal-digits="0"'
                    + ' role="application"></div>';
            }
        ]
    },

    'web_log.request_processing_time': {
        mainheads: [
            function (os, id) {
                void (os);
                return '<div data-netdata="' + id + '"'
                    + ' data-dimensions="avg"'
                    + ' data-chart-library="gauge"'
                    + ' data-title="Average Response Time"'
                    + ' data-units="milliseconds"'
                    + ' data-gauge-adjust="width"'
                    + ' data-width="12%"'
                    + ' data-before="0"'
                    + ' data-after="-CHART_DURATION"'
                    + ' data-points="CHART_DURATION"'
                    + ' data-colors="' + NETDATA.colors[4] + '"'
                    + ' data-decimal-digits="2"'
                    + ' role="application"></div>';
            }
        ]
    },

    // ------------------------------------------------------------------------
    // Port check

    'portcheck.latency': {
        info: '<code>延迟</code>描述连接到 TCP 端口所花费的时间。不发送或接收数据。 ' +
            '目前，延迟的精度较低，应仅用作参考。'
    },

    'portcheck.status': {
        valueRange: "[0, 1]",
        info: '<code>状态</code>图表验证服务的可用性。 ' +
            '如果触发，每个状态维度的值都将为 <code>1</code>。仅当可以建立连接时，维度 <code>success</code> 才为 <code>1</code>。 ' +
            '此图表对于警报和第三方应用程序最有用。'
    },

    // ------------------------------------------------------------------------
    // Chrony

    'chrony.stratum': {
        info: '层级表示到具有参考时钟的计算机的距离（跳数）。层级数字越高，时序精度和稳定性下降越多。',
    },

    'chrony.current_correction': {
        info: '系统时钟中的任何错误都通过略微加速或减速系统时钟来纠正，直到错误被消除，然后恢复到系统时钟的正常速度。其结果是，在一段时间内，系统时钟（由其他程序读取）将与 chronyd 对当前真实时间的估计（当它作为服务器运行时向 NTP 客户端报告）不同。报告的值是由于此效果而产生的差异。',
    },

    'chrony.root_delay': {
        info: '到最终同步此计算机的 stratum-1 计算机的网络路径延迟总和。'
    },

    'chrony.root_dispersion': {
        info: '通过所有计算机累积回到最终同步此计算机的 stratum-1 计算机的总分散度。分散度是由于系统时钟分辨率、统计测量变化等引起的。'
    },

    'chrony.last_offset': {
        info: '上次时钟更新时的估计本地偏移。正值表示本地时间（如先前估计的真实时间）领先于时间源。',
    },

    'chrony.frequency': {
        info: '<b>频率</b>是如果 chronyd 未纠正系统时钟，系统时钟将出错的速率。它以 ppm（百万分之一）表示。例如，值为 1 ppm 意味着当系统时钟认为它已前进 1 秒时，相对于真实时间它实际上已前进了 1.000001 秒。',
    },

    'chrony.residual_frequency': {
        info: '当前选定参考源的<b>残余频率</b>。这反映了参考源的测量表明频率应该是什么与当前使用的频率之间的任何差异。这不总是为零的原因是对频率应用了平滑程序。',
    },

    'chrony.skew': {
        info: '频率的估计误差界限。',
    },

    'chrony.ref_measurement_time': {
        info: '自处理来自参考源的最后一次测量以来经过的时间。',
    },

    'chrony.leap_status': {
        info: '<p>源的当前闰秒状态。</p><p><b>Normal</b> - 表示正常状态（无闰秒）。<b>InsertSecond</b> - 表示将在月底插入闰秒。<b>DeleteSecond</b> - 表示将在月底删除闰秒。<b>Unsynchronised</b> - 服务器未与 NTP 服务器正确同步。</p>',
    },

    'chrony.activity': {
        info: '<p>在线和离线的服务器和对等方的数量。</p><p><b>Online</b> - 服务器或对等方当前在线（即 chronyd 假定可达）。<b>Offline</b> - 服务器或对等方当前离线（即 chronyd 假定不可达，不会尝试从中进行测量）。<b>BurstOnline</b> - 已为服务器或对等方启动突发命令并正在执行。突发完成后，服务器或对等方将返回到在线状态。<b>BurstOffline</b> - 已为服务器或对等方启动突发命令并正在执行。突发完成后，服务器或对等方将返回到离线状态。<b>Unresolved</b> - 服务器或对等方的名称尚未解析为地址。</p>',
    },

    // ------------------------------------------------------------------------
    // Couchdb

    'couchdb.active_tasks': {
        info: '在此 CouchDB <b>集群</b>上运行的活动任务。目前存在四种类型的任务：索引器（视图构建）、复制、数据库压缩和视图压缩。'
    },

    'couchdb.replicator_jobs': {
        info: '此节点上正在进行的任何复制作业的详细细分。有关更多信息，请参阅<a href="http://docs.couchdb.org/en/latest/replication/replicator.html" target="_blank">复制器文档</a>。'
    },

    'couchdb.open_files': {
        info: 'CouchDB 打开的所有文件的计数。如果此值似乎固定在 1024 或 4096，您的服务器进程可能已达到打开文件句柄限制，<a href="http://docs.couchdb.org/en/latest/maintenance/performance.html#pam-and-ulimit" target="_blank">需要增加它</a>。'
    },

    'btrfs.disk': {
        info: 'BTRFS 的物理磁盘使用情况。此处报告的磁盘空间是分配给 BTRFS 卷的原始物理磁盘空间（即<b>在任何 RAID 级别之前</b>）。BTRFS 使用两阶段分配器，首先为一种类型的块（数据、元数据或系统）分配大区域的磁盘空间，然后在这些区域内使用常规块分配器。<code>unallocated</code> 是尚未分配且可按需成为数据、元数据或系统的物理磁盘空间。当 <code>unallocated</code> 为零时，所有可用磁盘空间都已分配给特定功能。健康的卷理想情况下应至少有其总空间的百分之五处于 <code>unallocated</code> 状态。您可以通过定期在卷上运行 <code>btrfs balance</code> 命令来保持卷的健康（查看 <code>man btrfs-balance</code> 了解更多信息）。请注意，如果卷使用不同大小的设备，列出为 <code>unallocated</code> 的某些空间可能实际上不可用。',
        colors: [NETDATA.colors[12]]
    },

    'btrfs.data': {
        info: 'BTRFS 数据的逻辑磁盘使用情况。数据块用于存储实际的文件数据（文件内容）。此处报告的磁盘空间是可用分配（即在任何条带化或复制之后）。健康的卷理想情况下不应该在此处持续报告超过几 GB 的可用空间。运行 <code>btrfs balance</code> 可以在此处提供帮助。'
    },

    'btrfs.metadata': {
        info: 'BTRFS 元数据的逻辑磁盘使用情况。元数据块存储大部分文件系统内部结构，以及目录结构和文件名等信息。此处报告的磁盘空间是可用分配（即在任何条带化或复制之后）。健康的卷理想情况下不应该在此处持续报告超过几 GB 的可用空间。运行 <code>btrfs balance</code> 可以在此处提供帮助。'
    },

    'btrfs.system': {
        info: 'BTRFS 系统的逻辑磁盘使用情况。系统块存储有关其他块分配的信息。此处报告的磁盘空间是可用分配（即在任何条带化或复制之后）。此处报告的值应相对于数据和元数据较小，并将随卷大小和总体空间使用而扩展。'
    },

