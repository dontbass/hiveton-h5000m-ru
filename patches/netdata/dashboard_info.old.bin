    'ipv6.icmprouter': {
        info: '<p>传输的 ICMPv6 '+
        '<a href="https://en.wikipedia.org/wiki/Neighbor_Discovery_Protocol" target="_blank">路由器发现</a>消息数。</p>'+
        '<p>路由器<b>请求</b>消息从计算机主机发送到本地区域网络上的任何路由器，'+
        '以请求它们在网络上公布其存在。'+
        '路由器<b>通告</b>消息由本地区域网络上的路由器发送，以宣布其 IP 地址'+
        '可用于路由。</p>'
