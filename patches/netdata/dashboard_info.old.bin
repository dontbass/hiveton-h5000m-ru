    // ------------------------------------------------------------------------
    // IPv6

    'ipv6.packets': {
        info: '<p>此主机的 IPv6 数据包统计信息。</p>'+
        '<p><b>Received</b> - IP 层接收的数据包。'+
        '即使数据包稍后被丢弃，此计数器也会增加。'+
        '<b>Sent</b> - 通过 IP 层发送的数据包，包括单播和组播数据包。'+
        '此计数器不包括在 <b>Forwarded</b> 中计数的任何数据包。'+
        '<b>Forwarded</b> - 此主机不是其最终 IP 目的地的输入数据包，'+
        '因此尝试找到一条路由将它们转发到该最终目的地。'+
        '在不充当 IP 网关的主机中，此计数器将仅包括那些'+
        '<a href="https://en.wikipedia.org/wiki/Source_routing" target="_blank">源路由</a>'+
        '且源路由选项处理成功的数据包。'+
        '<b>Delivers</b> - 传递给上层协议的数据包，例如 TCP、UDP、ICMP 等。</p>'
    },

    'ipv6.fragsout': {
        info: '<p>此系统的 <a href="https://en.wikipedia.org/wiki/IP_fragmentation" target="_blank">IPv6 分片</a>'+
        '统计信息。</p>'+
        '<p><b>OK</b> - 已成功分片的数据包。'+
        '<b>Failed</b> - 已被丢弃的数据包，因为它们需要分片'+
        '但无法分片，例如由于设置了<i>不分片</i> (DF) 标志。'+
        '<b>All</b> - 作为分片结果生成的片段。</p>'
    },

    'ipv6.fragsin': {
        info: '<p>此系统的 <a href="https://en.wikipedia.org/wiki/IP_fragmentation" target="_blank">IPv6 重组</a>'+
        '统计信息。</p>'+
        '<p><b>OK</b> - 已成功重组的数据包。'+
        '<b>Failed</b> - IP 重组算法检测到的失败。'+
        '这不一定是丢弃的 IP 片段的计数，因为某些算法'+
        '可能在接收时通过组合片段而失去对片段数量的跟踪。'+
        '<b>Timeout</b> - 检测到的重组超时。'+
        '<b>All</b> - 需要重组的接收到的 IP 片段。</p>'
    },

    'ipv6.errors': {
        info: '<p>丢弃的 IPv6 数据包数。</p>'+
        '<p><b>InDiscards</b>、<b>OutDiscards</b> - 即使没有检测到错误'+
        '也被选择丢弃的数据包，以防止它们被传递到更高层协议。'+
        '<b>InHdrErrors</b> - IP 头中的错误，包括错误的校验和、版本号不匹配、'+
        '其他格式错误、生存时间超出等。'+
        '<b>InAddrErrors</b> - 无效的 IP 地址或目标 IP 地址不是本地地址且'+
        '未启用 IP 转发。'+
        '<b>InUnknownProtos</b> - 未知或不支持的协议。'+
        '<b>InTooBigErrors</b> - 大小超过链路 MTU。'+
        '<b>InTruncatedPkts</b> - 数据包帧未携带足够数据。'+
        '<b>InNoRoutes</b> - 转发时找不到路由。'+
        '<b>OutNoRoutes</b> - 找不到此主机生成的数据包的路由。</p>'
    },

    'ipv6.udppackets': {
        info: '传输的 UDP 数据包数。'
    },

    'ipv6.udperrors': {
        info: '<p>传输 UDP 数据包期间遇到的错误数。</p>'+
        '<b>RcvbufErrors</b> - 接收缓冲区已满。'+
        '<b>SndbufErrors</b> - 发送缓冲区已满、没有可用的内核内存，或'+
        'IP 层在尝试发送数据包时报告错误且未设置错误队列。'+
        '<b>InErrors</b> - 这是所有错误的聚合计数器，不包括 <b>NoPorts</b>。'+
        '<b>NoPorts</b> - 没有应用程序在目标端口监听。'+
        '<b>InCsumErrors</b> - 检测到 UDP 校验和失败。'+
        '<b>IgnoredMulti</b> - 忽略的组播数据包。'
    },

    'ipv6.udplitepackets': {
        info: '传输的 UDP-Lite 数据包数。'
    },

    'ipv6.udpliteerrors': {
        info: '<p>传输 UDP-Lite 数据包期间遇到的错误数。</p>'+
