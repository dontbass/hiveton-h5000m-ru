    'nfsd.filehandles': {
        info: '<p>文件句柄统计信息。 '+
        '文件句柄是跟踪打开文件的小块内存。</p>'+
        '<p><b>Stale</b> - 当文件句柄引用已被回收的位置时发生。 '+
