    'system.shared_memory_bytes': {
        info: 'System V IPC 内存段当前使用的内存量。'+
        '可以创建的最大共享内存段大小的运行时限制在 <code>/proc/sys/kernel/shmmax</code> 文件中指定。'
    },

    'system.shared_memory_calls': {
        info: '调用负责操作<a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#ipc-shared-memory" target="_blank">共享内存</a>的系统调用的次数。如果<a href="https://learn.netdata.cloud/guides/troubleshoot/monitor-debug-applications-ebpf" target="_blank">apps</a> 或 <a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#integration-with-cgroupsplugin" target="_blank">cgroup (systemd 服务)</a>插件启用，Netdata 显示每个<a href="#ebpf_apps_shm_get">应用程序</a>和<a href="#ebpf_services_shm_get">cgroup (systemd 服务)</a>的共享内存指标。' + ebpfChartProvides + '<div id="ebpf_global_shm"></div>'
    },

    'system.message_queue_messages': {
        info: 'System V IPC 消息队列中当前存在的消息数。'
    },

    'system.message_queue_bytes': {
        info: 'System V IPC 消息队列中的消息当前使用的内存量。'
    },

    'system.uptime': {
        info: '系统已运行的时间量，包括暂停时间。'
    },

    'system.process_thread': {
        title : '任务创建',
        info: '调用<a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#processes" target="_blank">启动进程或线程的函数</a>的次数。如果<a href="https://learn.netdata.cloud/guides/troubleshoot/monitor-debug-applications-ebpf" target="_blank">apps</a> 或 <a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#integration-with-cgroupsplugin" target="_blank">cgroup (systemd 服务)</a>插件启用，Netdata 显示每个<a href="#ebpf_apps_process_create">应用程序</a>和<a href="#ebpf_services_process_create">cgroup (systemd 服务)</a>的进程指标。' + ebpfChartProvides + '<div id="ebpf_system_process_thread"></div>'
    },

    'system.exit': {
        title : '退出监控',
        info: '调用<a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#process-exit" target="_blank">负责关闭进程或线程的函数</a>的次数。如果<a href="https://learn.netdata.cloud/guides/troubleshoot/monitor-debug-applications-ebpf" target="_blank">apps</a> 或 <a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#integration-with-cgroupsplugin" target="_blank">cgroup (systemd 服务)</a>插件启用，Netdata 显示每个<a href="#ebpf_apps_process_exit">应用程序</a>和<a href="#ebpf_services_process_exit">cgroup (systemd 服务)</a>的进程指标。' + ebpfChartProvides + '<div id="ebpf_system_process_exit"></div>'
    },

    'system.task_error': {
        title : '任务错误',
        info: '调用<a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#task-error" target="_blank">启动进程或线程的函数</a>失败的次数。如果<a href="https://learn.netdata.cloud/guides/troubleshoot/monitor-debug-applications-ebpf" target="_blank">apps</a> 或 <a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#integration-with-cgroupsplugin" target="_blank">cgroup (systemd 服务)</a>插件启用，Netdata 显示每个<a href="#ebpf_apps_task_error">应用程序</a>和<a href="#ebpf_services_task_error">cgroup (systemd 服务)</a>的进程指标。' + ebpfChartProvides + '<div id="ebpf_system_task_error"></div>'
    },

    'system.process_status': {
        title : '任务状态',
        info: '调用<a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#process-exit" target="_blank">关闭任务和释放任务的函数</a>次数之间的差异。'+ ebpfChartProvides
    },

    // ------------------------------------------------------------------------
    // CPU charts

    'cpu.cpu': {
        commonMin: true,
        commonMax: true,
        valueRange: "[0, 100]"
    },

    'cpu.interrupts': {
        commonMin: true,
        commonMax: true
    },

    'cpu.softirqs': {
        commonMin: true,
        commonMax: true
    },

    'cpu.softnet_stat': {
        commonMin: true,
        commonMax: true
    },

    'cpu.core_throttling': {
        info: '根据 CPU 核心温度对 CPU 时钟速度进行的调整次数。'
    },

    'cpu.package_throttling': {
        info: '根据 CPU 封装（芯片）温度对 CPU 时钟速度进行的调整次数。'
    },

    'cpufreq.cpufreq': {
        info: '频率测量 CPU 每秒执行的周期数。'
    },

    'cpuidle.cpuidle': {
        info: '在 C 状态下花费的时间百分比。'
    },

    // ------------------------------------------------------------------------
    // MEMORY

    'mem.ksm': {
        info: '<p>内存页面合并统计信息。'+
        '<b>Sharing</b> 与 <b>Shared</b> 的高比率表示良好的共享，'+
        '但 <b>Unshared</b> 与 <b>Sharing</b> 的高比率表示浪费努力。</p>'+
        '<p><b>Shared</b> - 使用的共享页面。'+
        '<b>Unshared</b> - 不再共享的内存（页面是唯一的，但重复检查以进行合并）。'+
        '<b>Sharing</b> - 当前共享的内存（有多少站点正在共享页面，即节省了多少）。'+
        '<b>Volatile</b> - 易失页面（变化太快而无法放入树中）。</p>'
    },

    'mem.ksm_savings': {
        heads: [
            netdataDashboard.gaugeChart('节省', '12%', 'savings', '#0099CC')
        ],
        info: '<p>KSM 节省的内存量。</p>'+
        '<p><b>Savings</b> - 节省的内存。'+
        '<b>Offered</b> - 标记为可合并的内存。</p>'
    },

    'mem.ksm_ratios': {
        heads: [
            function (os, id) {
                void (os);
                return '<div data-netdata="' + id + '"'
                    + ' data-gauge-max-value="100"'
                    + ' data-chart-library="gauge"'
                    + ' data-title="节省率"'
                    + ' data-units="percentage %"'
                    + ' data-gauge-adjust="width"'
                    + ' data-width="12%"'
                    + ' data-before="0"'
                    + ' data-after="-CHART_DURATION"'
                    + ' data-points="CHART_DURATION"'
                    + ' role="application"></div>';
            }
        ],
        info: 'KSM 的有效性。'+
        '这是当前合并的可合并页面的百分比。'
    },

    'mem.zram_usage': {
        info: 'ZRAM 总 RAM 使用指标。ZRAM 使用一些内存来存储有关已存储内存页面的元数据，从而引入与磁盘大小成比例的开销。它排除相同元素填充的页面，因为没有为它们分配内存。'
    },

    'mem.zram_savings': {
        info: '显示原始和压缩的内存数据大小。'
    },

    'mem.zram_ratio': {
        heads: [
            netdataDashboard.gaugeChart('压缩率', '12%', 'ratio', '#0099CC')
        ],
        info: '压缩率，计算为 <code>100 * original_size / compressed_size</code>。值越大表示压缩越好，RAM 节省越多。'
    },

    'mem.zram_efficiency': {
        heads: [
            netdataDashboard.gaugeChart('效率', '12%', 'percent', NETDATA.colors[0])
        ],
        commonMin: true,
        commonMax: true,
        valueRange: "[0, 100]",
        info: '内存使用效率，计算为 <code>100 * compressed_size / total_mem_used</code>。'
    },


    'mem.pgfaults': {
        info: '<p><a href="https://en.wikipedia.org/wiki/Page_fault" target="_blank">页面错误</a>是一种中断类型，'+
        '称为陷阱，当正在运行的程序访问映射到虚拟地址空间但实际上未加载到主内存中的内存页面时，由计算机硬件引发。</p>'+
        '</p><b>Minor</b> - 在生成错误时，页面已加载到内存中，'+
        '但未在内存管理单元中标记为已加载到内存中。'+
        '<b>Major</b> - 当系统需要从磁盘或交换内存加载内存页面时生成。</p>'
    },

    'mem.committed': {
        colors: NETDATA.colors[3],
        info: '已提交内存，是进程分配的所有内存的总和。'
    },

    'mem.real': {
        colors: NETDATA.colors[3],
        info: '使用的真实（物理）内存总量。'
    },

    'mem.oom_kill': {
        info: '被<a href="https://en.wikipedia.org/wiki/Out_of_memory" target="_blank">内存不足</a>杀手终止的进程数。'+
        '当系统内存不足且无法在不终止一个或多个进程的情况下继续进行时，会召唤内核的 OOM 杀手。'+
        '它试图选择其终止将释放最多内存同时对系统用户造成最少痛苦的进程。'+
        '此计数器还包括超出内存限制的容器内的进程。'
    },

    'mem.numa': {
        info: '<p>NUMA 平衡统计信息。</p>'+
        '<p><b>Local</b> - 在此节点上由此节点上的进程成功分配的页面。'+
        '<b>Foreign</b> - 最初打算用于此节点但被分配到另一个节点的页面。'+
        '<b>Interleave</b> - 成功分配到此节点的交叉策略页面。'+
        '<b>Other</b> - 在此节点上由另一个节点上的进程分配的页面。'+
        '<b>PteUpdates</b> - 被标记为 NUMA 提示错误的基本页面。'+
        '<b>HugePteUpdates</b> - 被标记为 NUMA 提示错误的透明大页。'+
        '与 <b>pte_updates</b> 结合使用，可以计算已标记的总地址空间。'+
        '<b>HintFaults</b> - 被捕获的 NUMA 提示错误。'+
        '<b>HintFaultsLocal</b> - 指向本地节点的提示错误。'+
        '与 <b>HintFaults</b> 结合使用，可以计算本地与远程错误的百分比。'+
        '本地提示错误的高百分比表明工作负载更接近收敛。'+
        '<b>PagesMigrated</b> - 因放置错误而被迁移的页面。'+
        '由于迁移是一个复制操作，它贡献了 NUMA 平衡产生的大部分开销。</p>'
    },

    'mem.available': {
        info: function (os) {
            if (os === "freebsd")
                return '用户空间进程可以使用而不会导致交换的内存量。计算为空闲、缓存和非活动内存的总和。';
            else
                return '可用内存由内核估算，作为用户空间进程可以使用而不会导致交换的 RAM 量。';
        }
    },

    'mem.writeback': {
        info: '<b>Dirty</b> 是等待写入磁盘的内存量。<b>Writeback</b> 是正在主动写入磁盘的内存量。'
    },

    'mem.kernel': {
        info: '<p>内核使用的内存总量。</p>'+
        '<p><b>Slab</b> - 内核用于缓存其自身使用的数据结构。'+
        '<b>KernelStack</b> - 为内核完成的每个任务分配。'+
        '<b>PageTables</b> - 专用于最低级别的页表（页表用于将虚拟地址转换为物理内存地址）。'+
        '<b>VmallocUsed</b> - 用作虚拟地址空间。'+
        '<b>Percpu</b> - 分配给用于支持每 CPU 分配的每 CPU 分配器（不包括元数据的成本）。'+
        '当您创建每 CPU 变量时，系统上的每个处理器都会获得该变量的自己的副本。</p>'
    },

    'mem.slab': {
        info: '<p><a href="https://en.wikipedia.org/wiki/Slab_allocation" target="_blank">Slab 内存</a>统计信息。<p>'+
        '<p><b>Reclaimable</b> - 内核可以重用的内存量。'+
        '<b>Unreclaimable</b> - 即使内核缺少内存也无法重用。</p>'
    },

    'mem.hugepages': {
        info: '专用（或直接）大页是为配置为使用大页的应用程序保留的内存。大页是<b>已使用</b>的内存，即使有可用的空闲大页。'
    },

    'mem.transparent_hugepages': {
        info: '透明大页 (THP) 使用大页支持虚拟内存，支持页面大小的自动升级和降级。它适用于匿名内存映射和 tmpfs/shmem 的所有应用程序。'
    },

    'mem.hwcorrupt': {
        info: '由 <a href="https://en.wikipedia.org/wiki/ECC_memory" target="_blank">ECC</a> 识别并由内核搁置以避免使用的存在物理损坏问题的内存量。'
    },

    'mem.ecc_ce': {
        info: '可纠正（单位）ECC 错误的数量。'+
        '这些错误不会影响系统的正常运行，'+
        '因为它们仍在被纠正。'+
        '周期性的可纠正错误可能表明其中一个内存模块正在慢慢失效。'
    },

    'mem.ecc_ue': {
        info: '不可纠正（多位）ECC 错误的数量。'+
        '不可纠正的错误是致命问题，通常会导致操作系统崩溃。'
    },

    'mem.pagetype_global': {
        info: '特定大小块中可用的内存量。'
    },

    'mem.cachestat_ratio': {
        info: '<a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#page-cache-ratio" target="_blank">比率</a>显示直接在内存中访问的数据百分比。如果<a href="https://learn.netdata.cloud/guides/troubleshoot/monitor-debug-applications-ebpf" target="_blank">apps</a> 或 <a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#integration-with-cgroupsplugin" target="_blank">cgroup (systemd 服务)</a>插件启用，Netdata 显示每个<a href="#ebpf_apps_cachestat_ratio">应用程序</a>和<a href="#ebpf_services_cachestat_ratio">cgroup (systemd 服务)</a>的比率。' + ebpfChartProvides
    },

    'mem.cachestat_dirties': {
        info: '<a href="https://en.wikipedia.org/wiki/Page_cache" target="_blank">Linux 页缓存</a>中<a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#dirty-pages" target="_blank">已修改页面</a>的数量。如果<a href="https://learn.netdata.cloud/guides/troubleshoot/monitor-debug-applications-ebpf" target="_blank">apps</a> 或 <a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#integration-with-cgroupsplugin" target="_blank">cgroup (systemd 服务)</a>插件启用，Netdata 显示每个<a href="#ebpf_apps_cachestat_dirties">应用程序</a>和<a href="#ebpf_services_cachestat_dirties">cgroup (systemd 服务)</a>的脏页。' + ebpfChartProvides + '<div id="ebpf_global_cachestat_dirty"></div>'
    },

    'mem.cachestat_hits': {
        info: '<a href="https://en.wikipedia.org/wiki/Page_cache" target="_blank">Linux 页缓存</a>中数据的<a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#page-cache-hits" target="_blank">访问</a>次数。如果<a href="https://learn.netdata.cloud/guides/troubleshoot/monitor-debug-applications-ebpf" target="_blank">apps</a> 或 <a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#integration-with-cgroupsplugin" target="_blank">cgroup (systemd 服务)</a>插件启用，Netdata 显示每个<a href="#ebpf_apps_cachestat_hits">应用程序</a>和<a href="#ebpf_services_cachestat_hits">cgroup (systemd 服务)</a>的命中。' + ebpfChartProvides + '<div id="ebpf_global_cachestat_hits"></div>'
    },

    'mem.cachestat_misses': {
        info: '<a href="https://en.wikipedia.org/wiki/Page_cache" target="_blank">Linux 页缓存</a>中不存在的数据的<a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#page-cache-misses" target="_blank">访问</a>次数。如果<a href="https://learn.netdata.cloud/guides/troubleshoot/monitor-debug-applications-ebpf" target="_blank">apps</a> 或 <a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#integration-with-cgroupsplugin" target="_blank">cgroup (systemd 服务)</a>插件启用，Netdata 显示每个<a href="#ebpf_apps_cachestat_misses">应用程序</a>和<a href="#ebpf_services_cachestat_misses">cgroup (systemd 服务)</a>的未命中访问。' + ebpfChartProvides + '<div id="ebpf_global_cachestat_misses"></div>'
    },

    'mem.sync': {
        info: '调用同步文件系统元数据或缓存的<a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#file-system-sync" target="_blank">系统调用</a>的次数。此图表与<a href="#menu_filesystem">文件系统</a>和 Linux <a href="#menu_mem_submenu_page_cache">页缓存</a>有关。' + ebpfChartProvides
    },

    'mem.file_sync': {
        info: '调用负责将修改的 Linux 页缓存传输到磁盘的<a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#file-sync" target="_blank">系统调用</a>的次数。此图表与<a href="#menu_filesystem">文件系统</a>和 Linux <a href="#menu_mem_submenu_page_cache">页缓存</a>有关。' + ebpfChartProvides
    },

    'mem.memory_map': {
        info: '调用负责映射文件的内核副本的<a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#memory-map-sync" target="_blank">系统调用</a>的次数。此图表与<a href="#menu_filesystem">文件系统</a>和 Linux <a href="#menu_mem_submenu_page_cache">页缓存</a>有关。' + ebpfChartProvides
    },

    'mem.file_segment': {
        info: '调用负责同步文件段的<a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#file-range-sync" target="_blank">系统调用</a>的次数。此图表与<a href="#menu_filesystem">文件系统</a>和 Linux <a href="#menu_mem_submenu_page_cache">页缓存</a>有关。' + ebpfChartProvides
    },

    'filesystem.dc_hit_ratio': {
        info: '存在于<a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#directory-cache" target="_blank">目录缓存</a>中的文件访问百分比。如果<a href="https://learn.netdata.cloud/guides/troubleshoot/monitor-debug-applications-ebpf" target="_blank">apps</a> 或 <a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#integration-with-cgroupsplugin" target="_blank">cgroup (systemd 服务)</a>插件启用，Netdata 显示每个<a href="#ebpf_apps_dc_hit">应用程序</a>和<a href="#ebpf_services_dc_hit">cgroup (systemd 服务)</a>的目录缓存指标。' + ebpfChartProvides + '<div id="ebpf_dc_hit_ratio"></div>'
    },

    'filesystem.dc_reference': {
        info: '文件访问计数器。<code>Reference</code> 是文件访问且文件不存在于目录缓存中时。<code>Miss</code> 是文件访问且文件在文件系统中未找到时。<code>Slow</code> 是文件访问且文件存在于文件系统中但不在目录缓存中时。如果<a href="https://learn.netdata.cloud/guides/troubleshoot/monitor-debug-applications-ebpf" target="_blank">apps</a> 或 <a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#integration-with-cgroupsplugin" target="_blank">cgroup (systemd 服务)</a>插件启用，Netdata 显示每个<a href="#ebpf_apps_dc_reference">应用程序</a>和<a href="#ebpf_services_dc_reference">cgroup (systemd 服务)</a>的目录缓存指标。' + ebpfChartProvides + '<div id="ebpf_dc_reference"></div>'
    },

    'md.health': {
        info: '每个 MD 阵列的失败设备数。'+
        'Netdata 从 md 状态行的 <b>[n/m]</b> 字段检索此数据。'+
        '这意味着理想情况下阵列将有 <b>n</b> 个设备，但是当前正在使用 <b>m</b> 个设备。'+
        '<code>failed disks</code> 是 <b>n-m</b>。'
    },
    'md.disks': {
        info: '正在使用和处于关闭状态的设备数。'+
        'Netdata 从 md 状态行的 <b>[n/m]</b> 字段检索此数据。'+
        '这意味着理想情况下阵列将有 <b>n</b> 个设备，但是当前正在使用 <b>m</b> 个设备。'+
        '<code>inuse</code> 是 <b>m</b>，<code>down</code> 是 <b>n-m</b>。'
    },
    'md.status': {
        info: '正在进行的操作的完成进度。'
    },
    'md.expected_time_until_operation_finish': {
        info: '完成正在进行的操作的预计时间。'+
        '时间只是一个近似值，因为操作速度将根据其他 I/O 需求而变化。'
    },
    'md.operation_speed': {
        info: '正在进行的操作的速度。'+
        '系统范围的重建速度限制在 <code>/proc/sys/dev/raid/{speed_limit_min,speed_limit_max}</code> 文件中指定。'+
        '这些选项适合调整重建过程，可能会增加整体系统负载、CPU 和内存使用量。'
    },
    'md.mismatch_cnt': {
        info: '在执行<b>检查</b>和<b>修复</b>时，可能在执行<b>重新同步</b>时，md 将计算找到的错误数。'+
        '不匹配计数记录在 <code>sysfs</code> 文件 <code>md/mismatch_cnt</code> 中。'+
        '此值是被重写的扇区数，或（对于<b>检查</b>）将被重写的扇区数。'+
        '它可能比实际错误数大页面中扇区数的倍数。'+
        '在 RAID1 或 RAID10 上无法非常可靠地解释不匹配，特别是当设备用于交换时。'+
        '在真正干净的 RAID5 或 RAID6 阵列上，任何不匹配都应该表明某个级别的硬件问题 - '+
        '软件问题永远不应该导致这种不匹配。'+
        '有关详细信息，请参阅 <a href="https://man7.org/linux/man-pages/man4/md.4.html" target="_blank">md(4)</a>。'
    },
    'md.flush': {
        info: '每个 MD 阵列的刷新计数。基于 BCC 工具中的 eBPF <a href="https://github.com/iovisor/bcc/blob/master/tools/mdflush_example.txt" target="_blank">mdflush</a>。'
    },

    // ------------------------------------------------------------------------
    // IP

    'ip.inerrors': {
        info: '<p>接收 IP 数据包期间遇到的错误数。</p>' +
            '</p><b>NoRoutes</b> - 因没有路由发送而丢弃的数据包。' +
            '<b>Truncated</b> - 因数据报帧未携带足够数据而被丢弃的数据包。' +
            '<b>Checksum</b> - 因校验和错误而丢弃的数据包。</p>'
    },

    'ip.mcast': {
        info: '系统中的总组播流量。'
    },

    'ip.mcastpkts': {
        info: '系统中传输的总组播数据包数。'
    },

    'ip.bcast': {
        info: '系统中的总广播流量。'
    },

    'ip.bcastpkts': {
        info: '系统中传输的总广播数据包数。'
    },

    'ip.ecnpkts': {
        info: '<p>系统中接收到设置了 ECN 位的 IP 数据包总数。</p>'+
        '<p><b>CEP</b> - 遇到拥塞。'+
        '<b>NoECTP</b> - 不支持 ECN 的传输。'+
