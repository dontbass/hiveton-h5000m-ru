    'sctp.established': {
        info: '当前状态为'+
        'ESTABLISHED、SHUTDOWN-RECEIVED 或 SHUTDOWN-PENDING 的关联数。'
    },

    'sctp.transitions': {
        info: '<p>关联在状态之间进行直接转换的次数。</p>'+
        '<p><b>Active</b> - 从 COOKIE-ECHOED 到 ESTABLISHED。上层发起关联尝试。'+
        '<b>Passive</b> - 从 CLOSED 到 ESTABLISHED。远程端点发起关联尝试。'+
        '<b>Aborted</b> - 从任何状态使用原语 ABORT 到 CLOSED。关联的非正常终止。'+
        '<b>Shutdown</b> - 从 SHUTDOWN-SENT 或 SHUTDOWN-ACK-SENT 到 CLOSED。关联的正常终止。</p>'
    },

    'sctp.packets': {
        info: '<p>传输的 SCTP 数据包数。</p>'+
        '<p><b>Received</b> - 包括重复数据包。'+
        '<b>Sent</b> - 包括重传的 DATA 块。</p>'
    },

    'sctp.packet_errors': {
        info: '<p>接收 SCTP 数据包期间遇到的错误数。</p>'+
        '<p><b>Invalid</b> - 接收方无法识别适当关联的数据包。'+
        '<b>Checksum</b> - 具有无效校验和的数据包。</p>'
    },

    'sctp.fragmentation': {
        info: '<p>分片和重组的 SCTP 消息数。</p>'+
