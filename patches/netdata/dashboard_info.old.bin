    'system.ipc semaphores': {
        title: 'IPC 信号量',
        info: 'System V 信号量是一种进程间通信 (IPC) 机制。'+
        '它允许进程或进程内的线程同步其操作。'+
        '它们通常用于监控和控制系统资源（如共享内存段）的可用性。' +
        '有关详细信息，请参阅 <a href="https://man7.org/linux/man-pages/man7/svipc.7.html" target="_blank">svipc(7)</a>。' +
        '要查看主机 IPC 信号量信息，运行 <code>ipcs -us</code>。对于限制，运行 <code>ipcs -ls</code>。'
    },

    'system.ipc shared memory': {
        title: 'IPC 共享内存',
        info: 'System V 共享内存是一种进程间通信 (IPC) 机制。'+
        '它允许进程通过共享内存区域来通信信息。'+
        '这是可用的最快的进程间通信形式，因为当数据在进程之间传递时不涉及内核（无需复制）。'+
        '通常，进程必须使用例如 POSIX 信号量来同步对共享内存对象的访问。'+
        '有关详细信息，请参阅 <a href="https://man7.org/linux/man-pages/man7/svipc.7.html" target="_blank">svipc(7)</a>。'+
        '要查看主机 IPC 共享内存信息，运行 <code>ipcs -um</code>。对于限制，运行 <code>ipcs -lm</code>。'
    },

    'system.ipc message queues': {
        title: 'IPC 消息队列',
        info: 'System V 消息队列是一种进程间通信 (IPC) 机制。'+
        '它允许进程以消息形式交换数据。'+
        '有关详细信息，请参阅 <a href="https://man7.org/linux/man-pages/man7/svipc.7.html" target="_blank">svipc(7)</a>。' +
        '要查看主机 IPC 消息信息，运行 <code>ipcs -uq</code>。对于限制，运行 <code>ipcs -lq</code>。'
    },

