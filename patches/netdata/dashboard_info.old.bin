    },

    'ip.total_tcp_bandwidth': {
        info: '使用 <a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#tcp-bandwidth" target="_blank">TCP 内部函数</a>发送和接收的字节总数。' +
        '如果<a href="https://learn.netdata.cloud/guides/troubleshoot/monitor-debug-applications-ebpf" target="_blank">apps</a> 或' +
