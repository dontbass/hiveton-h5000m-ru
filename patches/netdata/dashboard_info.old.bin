    },
    'consul.raft_boltdb_freelist_bytes': {
        info: '编码空闲列表元数据所需的字节数。当 <a href="https://developer.hashicorp.com/consul/docs/agent/config/config-files#NoFreelistSync" target="_blank">raft_boltdb.NoFreelistSync</a> 设置为 <i>false</i> 时，这些元数据字节也必须为每个提交的日志写入磁盘。'
    },
    'consul.raft_boltdb_logs_per_batch_rate': {
        info: '每批写入数据库的日志数。'
    },
    'consul.raft_boltdb_store_logs_time': {
        info: '将日志写入数据库所花费的时间。'
    },
    'consul.license_expiration_time': {
        info: 'Consul Enterprise 许可证到期之前剩余的时间。当许可证到期时，某些 Consul Enterprise 功能将停止工作。'
    },

    // ------------------------------------------------------------------------
    // WMI (Process)

    'wmi.processes_cpu_time': {
        info: 'CPU 总利用率。进程在<a href="https://en.wikipedia.org/wiki/CPU_modes#Mode_types" target="_blank">用户和特权</a>模式下花费的时间。'
    },
    'wmi.processes_handles': {
        info: '进程打开的<a href="https://learn.microsoft.com/en-us/windows/win32/sysinfo/handles-and-objects" target="_blank">句柄</a>总数。此数字是进程中每个线程当前打开的句柄总和。'
    },
    'wmi.processes_io_bytes': {
        info: '在不同模式（读取、写入、其他）下发出的 I/O 操作字节数。此属性统计进程生成的所有 I/O 活动，包括文件、网络和设备 I/O。读取和写入模式包括数据操作；其他模式包括不涉及数据的操作，例如控制操作。'
    },
    'wmi.processes_io_operations': {
        info: '在不同模式（读取、写入、其他）下发出的 I/O 操作数。此属性统计进程生成的所有 I/O 活动，包括文件、网络和设备 I/O。读取和写入模式包括数据操作；其他模式包括不涉及数据的操作，例如控制操作。'
    },
    'wmi.processes_page_faults': {
        info: '在此进程中执行的线程产生的页面错误。当线程引用不在主内存中的工作集中的虚拟内存页面时，会发生页面错误。如果页面在待机列表中并因此已经在主内存中，或者被与该页面共享的另一个进程使用，这可能导致不从磁盘获取页面。'
    },
    'wmi.processes_file_bytes': {
        info: '此进程在分页文件中使用的当前字节数。分页文件用于存储进程使用的、未包含在其他文件中的内存页面。分页文件由所有进程共享，分页文件中的空间不足会阻止其他进程分配内存。'
    },
    'wmi.processes_pool_bytes': {
        info: '池字节数是分页或非分页池中最后观察到的字节数。非分页池是系统内存区域（操作系统使用的物理内存），用于无法写入磁盘但在分配时必须保留在物理内存中的对象。分页池是系统内存区域（操作系统使用的物理内存），用于在不使用时可以写入磁盘的对象。'
    },
    'wmi.processes_threads': {
        info: '此进程中当前活动的线程数。指令是处理器中执行的基本单位，线程是执行指令的对象。每个正在运行的进程至少有一个线程。'
    },

    // ------------------------------------------------------------------------
    // WMI (TCP)

    'wmi.tcp_conns_active': {
        info: 'TCP 连接从 CLOSED 状态直接转换到 SYN-SENT 状态的次数。'
    },
    'wmi.tcp_conns_established': {
        info: '当前状态为 ESTABLISHED 或 CLOSE-WAIT 的 TCP 连接数。'
    },
    'wmi.tcp_conns_failures': {
        info: 'TCP 连接从 SYN-SENT 状态或 SYN-RCVD 状态直接转换到 CLOSED 状态的次数，加上 TCP 连接从 SYN-RCVD 状态直接转换到 LISTEN 状态的次数。'
    },
    'wmi.tcp_conns_passive': {
        info: 'TCP 连接从 LISTEN 状态直接转换到 SYN-RCVD 状态的次数。'
    },
    'wmi.tcp_conns_resets': {
        info: 'TCP 连接从 LISTEN 状态直接转换到 SYN-RCVD 状态的次数。'
    },
    'wmi.tcp_segments_received': {
        info: '接收段的速率，包括接收错误的段。此计数包括在当前建立的连接上接收的段。'
    },
    'wmi.tcp_segments_retransmitted': {
        info: '重传段的速率，即包含一个或多个先前传输字节的传输段。'
    },
    'wmi.tcp_segments_sent': {
        info: '发送段的速率，包括当前连接上的段，但不包括仅包含重传字节的段。'
    },

    // ------------------------------------------------------------------------
    // WMI (IIS)

    'iis.website_isapi_extension_requests_count': {
        info: 'Web 服务并发处理的 <a href="https://learn.microsoft.com/en-us/previous-versions/iis/6.0-sdk/ms525282(v=vs.90)" target="_blank">ISAPI 扩展</a>请求数。'
    },
    'iis.website_errors_rate': {
        info: '<p>服务器无法满足的请求数。</p><p><b>DocumentLocked</b> - 请求的文档已锁定。通常报告为 HTTP 错误 423。<b>DocumentNotFound</b> - 未找到请求的文档。通常报告为 HTTP 错误 404。</p>'
    },

    // ------------------------------------------------------------------------
    // WMI (Service)

    'wmi.service_status': {
        info: '服务的当前<a href="https://learn.microsoft.com/en-us/windows/win32/services/service-status-transitions" target="_blank">状态</a>。'
    },

    // ------------------------------------------------------------------------
    // WMI (MSSQL)

    'mssql.instance_accessmethods_page_splits': {
        info : '当页面没有更多空间时发生页面拆分。此图表显示由于索引页面溢出而每秒发生的页面拆分数。'
    },

    'mssql.instance_cache_hit_ratio': {
        info : '指示在缓冲区缓存中找到而无需从磁盘读取的页面百分比。该比率是在最近几千次页面访问中缓存命中总数除以缓存查找总数。经过很长一段时间后，该比率变化很小。由于从缓存读取比从磁盘读取成本低得多，因此您希望此比率很高。'
    },

    'mssql.instance_bufman_checkpoint_pages': {
        info : '指示检查点或需要刷新所有脏页的其他操作每秒刷新到磁盘的页面数。'
    },

    'mssql.instance_bufman_page_life_expectancy': {
        info : '指示页面在缓冲池中停留而没有引用的秒数。'
    },

    'mssql.instance_memmgr_external_benefit_of_memory': {
        info : '引擎使用它来平衡缓存之间的内存使用情况，在对意外缓存增长的情况进行故障排除时很有用。该值基于内部计算以整数形式呈现。'
    },

    'mssql.instance_sql_errors': {
        info: 'Microsoft SQL Server 中的错误。</p><p><b>Db_offline</b> - 跟踪导致 SQL Server 使当前数据库脱机的严重错误。<b>Info</b> - 与向用户提供信息但不会导致错误的错误消息相关的信息。<b>Kill_connection</b> - 跟踪导致 SQL Server 终止当前连接的严重错误。<b>User</b> - 用户错误。</p>'
    },

    'mssql.instance_sqlstats_auto_parameterization_attempts': {
        info: '当 SQL Server 实例尝试通过用参数替换某些文字来参数化 Transact-SQL 请求时，会发生自动参数化，以便可以在多个类似的请求之间重用生成的缓存执行计划。请注意，在较新版本的 SQL Server 中，自动参数化也称为简单参数化。此计数器不包括强制参数化。'
    },

    'mssql.instance_sqlstats_batch_requests': {
        info: '此统计信息受所有约束（如 I/O、用户数、缓存大小、请求复杂性等）的影响。批处理请求数高表示吞吐量良好。'
    },

    'mssql.instance_sqlstats_safe_auto_parameterization_attempts': {
        info: '请注意，在较新版本的 SQL Server 中，自动参数化也称为简单参数化。'
    },

    'mssql.instance_sqlstats_sql_compilations': {
        info: '指示进入编译代码路径的次数。包括由 SQL Server 中的语句级重新编译引起的编译。SQL Server 用户活动稳定后，此值将达到稳定状态。'
    },

