    },

    'system.ipc_semaphores': {
        info: '分配的 System V IPC 信号量数量。'+
        '所有信号量集中信号量数量的系统范围限制在 <code>/proc/sys/kernel/sem</code> 文件中指定（第 2 个字段）。'
    },

    'system.ipc_semaphore_arrays': {
        info: '使用的 System V IPC 信号量数组（集）数量。信号量支持信号量集，其中每个都是计数信号量。'+
