netdataDashboard.context = {
    'system.cpu': {
        title: 'CPU 使用率',
        info: function (os) {
            void (os);
            return 'CPU 总利用率（所有核心）。这里的 100% 意味着完全没有 CPU 空闲时间。您可以在 <a href="#menu_cpu">CPU</a> 部分获取每个核心的使用情况，在<a href="#menu_apps">应用程序监控</a>部分获取每个应用程序的使用情况。'
                + netdataDashboard.sparkline('<br/>请关注 <b>iowait</b> ', 'system.cpu', 'iowait', '%', '。如果它持续较高，说明您的磁盘是瓶颈，它们会拖慢您的系统。')
                + netdataDashboard.sparkline(
                '<br/>一个值得监控的重要指标是 <b>softirq</b> ',
