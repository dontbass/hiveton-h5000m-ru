    },
    'nginxplus.ssl_verification_errors_rate': {
        info: '<p>SSL 验证错误。</p><p><b>NoCert</b> - 客户端未提供所需的证书。<b>ExpiredCert</b> - 客户端提供了过期或尚未生效的证书。<b>RevokedCert</b> - 客户端提供了已吊销的证书。<b>HostnameMismatch</b> - 服务器的证书与主机名不匹配。<b>Other</b> - 其他 SSL 证书验证错误。</p>'
