    // NVMe

    'nvme.device_estimated_endurance_perc': {
        info: '基于实际使用情况和制造商对 NVM 寿命预测的 NVM 子系统已使用寿命。值为 100 表示设备的估计耐久性已被消耗，但可能不表示设备故障。如果您在计划寿命之外使用存储，该值可能大于 100。'
    },
    'nvme.device_available_spare_perc': {
        info: '可用的剩余备用容量。SSD 提供一组内部备用容量，称为备用块，可用于替换已达到其写入操作限制的块。在所有备用块都用完后，下一个达到限制的块将导致磁盘故障。'
    },
    'nvme.device_composite_temperature': {
        info: '控制器及其关联命名空间的当前综合温度。计算此值的方式取决于具体实现，可能不代表 NVM 子系统中任何物理点的实际温度。'
    },
    'nvme.device_io_transferred_count': {
        info: '主机读取和写入的数据总量。'
    },
    'nvme.device_power_cycles_count': {
        info: '电源周期反映了主机重启或设备从睡眠中唤醒的次数。大量的电源周期不会影响设备的预期寿命。'
    },
    'nvme.device_power_on_time': {
        info: '<a href="https://en.wikipedia.org/wiki/Power-on_hours" target="_blank">通电时间</a>是设备供电的时长。'
    },
    'nvme.device_unsafe_shutdowns_count': {
        info: '在未发送关闭通知的情况下发生断电的次数。根据您使用的 NVMe 设备，不安全关闭可能会损坏用户数据。'
    },
    'nvme.device_critical_warnings_state': {
        info: '<p>控制器状态的严重警告。如果设置为 1，则状态处于活动状态。</p><p><b>AvailableSpare</b> - 可用备用容量低于阈值。<b>TempThreshold</b> - 综合温度大于或等于过热阈值或小于或等于过冷阈值。<b>NvmSubsystemReliability</b> - 由于介质或内部错误过多，NVM 子系统可靠性降低。<b>ReadOnly</b> - 介质置于只读模式。<b>VolatileMemBackupFailed</b> - 易失性内存备份设备已失败。<b>PersistentMemoryReadOnly</b> - 持久内存区域已变为只读或不可靠。</p>'
    },
    'nvme.device_media_errors_rate': {
        info: '控制器检测到未恢复的数据完整性错误的次数。此计数器包括无法纠正的 ECC、CRC 校验和失败或 LBA 标签不匹配等错误。'
    },
    'nvme.device_error_log_entries_rate': {
        info: '错误信息日志中的条目数。记录数量的增加本身并不是任何故障情况的指标。'
    },
    'nvme.device_warning_composite_temperature_time': {
        info: '设备在警告综合温度阈值（WCTEMP）以上且低于临界综合温度阈值（CCTEMP）下运行的时间。'
    },
    'nvme.device_critical_composite_temperature_time': {
        info: '设备在临界综合温度阈值（CCTEMP）以上运行的时间。'
    },
    'nvme.device_thermal_mgmt_temp1_transitions_rate': {
        info: '由于主机管理的热管理功能，控制器进入较低活动电源状态或执行供应商特定的热管理操作（<b>最小化性能影响</b>）以尝试降低综合温度的次数。'
    },
    'nvme.device_thermal_mgmt_temp2_transitions_rate': {
        info: '由于主机管理的热管理功能，控制器进入较低活动电源状态或执行供应商特定的热管理操作（<b>无论对性能的影响如何（例如重度限制）</b>）以尝试降低综合温度的次数。'
    },
    'nvme.device_thermal_mgmt_temp1_time': {
        info: '由于主机管理的热管理功能，控制器进入较低活动电源状态或执行供应商特定的热管理操作（<b>最小化性能影响</b>）以尝试降低综合温度的时间量。'
    },
    'nvme.device_thermal_mgmt_temp2_time': {
        info: '由于主机管理的热管理功能，控制器进入较低活动电源状态或执行供应商特定的热管理操作（<b>无论对性能的影响如何（例如重度限制）</b>）以尝试降低综合温度的时间量。'
