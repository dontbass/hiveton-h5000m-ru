const cgroupCPULimit = '配置或系统范围（如果未设置）限制内的 CPU 总利用率。当 cgroup 的 CPU 利用率超过配置期间的限制时，属于其层次结构的任务将被限流，直到下一个周期才允许再次运行。'
const cgroupCPU = '系统范围 CPU 资源（所有核心）内的 CPU 总利用率。cgroup 的任务在<a href="https://en.wikipedia.org/wiki/CPU_modes#Mode_types" target="_blank">用户和内核</a>模式下花费的时间量。'
const cgroupThrottled = 'cgroup 中的任务被限流的可运行周期百分比。任务不被允许运行，因为它们已耗尽其 CPU 配额指定的所有可用时间。'
const cgroupThrottledDuration = 'cgroup 中的任务被限流的总时间持续时间。当应用程序在给定期间内使用完其分配的 CPU 配额时，它将被限流直到下一个周期。'
const cgroupCPUShared = '<p>生活在同一层次结构中的每个组的权重，转换为它预期获得的 CPU 量。分配给 cgroup 的 CPU 百分比是 shares 值除以同一级别所有 cgroups 中所有 shares 的总和。</p> <p>例如，<b>cpu.shares</b> 设置为 100 的两个 cgroups 中的任务将获得相等的 CPU 时间，但 <b>cpu.shares</b> 设置为 200 的 cgroup 中的任务获得的 CPU 时间是 <b>cpu.shares</b> 设置为 100 的 cgroup 中任务的两倍。</p>'
const cgroupCPUPerCore = '系统范围 CPU 资源内每个核心的 CPU 总利用率。'
const cgroupCPUSomePressure = 'CPU <a href="https://www.kernel.org/doc/html/latest/accounting/psi.html" target="_blank">压力停滞信息</a>。<b>Some</b> 表示至少有<b>某些任务</b>在 CPU 上停滞的时间份额。该比率作为 10、60 和 300 秒窗口的最近趋势进行跟踪。'
const cgroupCPUSomePressureStallTime = '某些进程等待 CPU 时间的时间量。'
const cgroupCPUFullPressure = 'CPU <a href="https://www.kernel.org/doc/html/latest/accounting/psi.html" target="_blank">压力停滞信息</a>。<b>Full</b> 表示<b>所有非空闲任务</b>同时在 CPU 资源上停滞的时间份额。该比率作为 10、60 和 300 秒窗口的最近趋势进行跟踪。'
const cgroupCPUFullPressureStallTime = '所有非空闲进程由于 CPU 拥塞而停滞的时间量。'

const cgroupMemUtilization = '配置或系统范围（如果未设置）限制内的 RAM 利用率。当 cgroup 的 RAM 利用率超过限制时，OOM 杀手将开始杀死属于该 cgroup 的任务。'
const cgroupMemUsageLimit = '配置或系统范围（如果未设置）限制内的 RAM 使用量。当 cgroup 的 RAM 使用量超过限制时，OOM 杀手将开始杀死属于该 cgroup 的任务。'
const cgroupMemUsage = '已使用的 RAM 和交换内存量。'
const cgroupMem = '内存使用统计信息。各个指标在 <a href="https://www.kernel.org/doc/html/latest/admin-guide/cgroup-v1/memory.html#per-memory-cgroup-local-status" target="_blank">cgroup-v1</a> 和 <a href="https://www.kernel.org/doc/html/latest/admin-guide/cgroup-v2.html#memory-interface-files" target="_blank">cgroup-v2</a> 的 memory.stat 部分中有描述。'
const cgroupMemFailCnt = '内存使用达到限制的次数。'
const cgroupWriteback = '<b>Dirty</b> 是等待写入磁盘的内存量。<b>Writeback</b> 是正在主动写入磁盘的内存量。'
const cgroupMemActivity = '<p>内存核算统计信息。</p><p><b>In</b> - 页面被核算为映射匿名页面 (RSS) 或缓存页面（页缓存）到 cgroup。<b>Out</b> - 从 cgroup 取消核算页面。</p>'
const cgroupPgFaults = '<p>内存<a href="https://en.wikipedia.org/wiki/Page_fault" target="_blank">页面错误</a>统计信息。</p><p><b>Pgfault</b> - 所有页面错误。<b>Swap</b> - 主要页面错误。</p>'
const cgroupMemorySomePressure = '内存<a href="https://www.kernel.org/doc/html/latest/accounting/psi.html" target="_blank">压力停滞信息</a>。<b>Some</b> 表示至少有<b>某些任务</b>在内存上停滞的时间份额。在这种状态下，CPU 仍在进行生产性工作。该比率作为 10、60 和 300 秒窗口的最近趋势进行跟踪。'
const cgroupMemorySomePressureStallTime = '某些进程由于内存拥塞而等待的时间量。'
const cgroupMemoryFullPressure = '内存<a href="https://www.kernel.org/doc/html/latest/accounting/psi.html" target="_blank">压力停滞信息</a>。<b>Full</b> 表示<b>所有非空闲任务</b>同时在内存资源上停滞的时间份额。在这种状态下，实际的 CPU 周期被浪费了，在这种状态下花费较长时间的工作负载被认为是抖动。这会严重影响性能。该比率作为 10、60 和 300 秒窗口的最近趋势进行跟踪。'
const cgroupMemoryFullPressureStallTime = '所有非空闲进程由于内存拥塞而停滞的时间量。'

