    // ------------------------------------------------------------------------
    // VMware vSphere

    // Host specific
    'vsphere.host_mem_usage_percentage': {
        info: '已使用机器内存的百分比：<code>consumed</code> / <code>machine-memory-size</code>。'
    },

    'vsphere.host_mem_usage': {
        info:
            '<code>granted</code> 是为主机映射的机器内存量，' +
            '它等于所有开机虚拟机的所有授予指标的总和，加上主机上 vSphere 服务的机器内存。' +
            '<code>consumed</code> 是主机上使用的机器内存量，它包括服务控制台、VMkernel、vSphere 服务使用的内存，加上所有运行虚拟机的总消耗指标。' +
            '<code>consumed</code> = <code>总主机内存</code> - <code>空闲主机内存</code>。' +
            '<code>active</code> 是所有开机虚拟机的所有活动指标的总和，加上主机上的 vSphere 服务（如 COS、vpxa）。' +
            '<code>shared</code> 是所有开机虚拟机的所有共享指标的总和，加上主机上 vSphere 服务的数量。' +
            '<code>sharedcommon</code> 是主机上所有开机虚拟机和 vSphere 服务共享的机器内存量。' +
            '<code>shared</code> - <code>sharedcommon</code> = 机器内存（主机内存）节省（KB）。' +
            '有关详细信息，请参阅<a href="https://docs.vmware.com/en/VMware-vSphere/6.5/com.vmware.vsphere.resmgmt.doc/GUID-BFDC988B-F53D-4E97-9793-A002445AFAE1.html" target="_blank">测量和区分内存使用类型</a>和' +
            '<a href="https://vdc-repo.vmware.com/vmwb-repository/dcr-public/fe08899f-1eec-4d8d-b3bc-a6664c168c2c/7fdf97a1-4c0d-4be0-9d43-2ceebbc174d9/doc/memory_counters.html" target="_blank">内存计数器</a>文章。'
    },

    'vsphere.host_mem_swap_rate': {
        info:
            '此统计信息指的是 VMkernel 交换，而不是客户操作系统交换。' +
            '<code>in</code> 是主机上所有开机虚拟机的 <code>swapinRate</code> 值的总和。' +
            '<code>swapinRate</code> 是 VMKernel 从交换文件将数据读入机器内存的速率。' +
            '<code>out</code> 是主机上所有开机虚拟机的 <code>swapoutRate</code> 值的总和。' +
            '<code>swapoutRate</code> 是 VMkernel 从机器内存写入虚拟机交换文件的速率。'
    },

    // VM specific
    'vsphere.vm_mem_usage_percentage': {
        info: '已使用虚拟机"物理"内存的百分比：<code>active</code> / <code>虚拟机配置大小</code>。'
    },

    'vsphere.vm_mem_usage': {
        info:
            '<code>granted</code> 是映射到机器内存的客户"物理"内存量，它包括 <code>shared</code> 内存量。' +
            '<code>consumed</code> 是虚拟机为客户内存消耗的客户"物理"内存量，' +
            '<code>consumed</code> = <code>granted</code> - <code>由于内存共享而节省的内存</code>。' +
            '<code>active</code> 是主动使用的内存量，由 VMkernel 根据最近触摸的内存页面估计。' +
            '<code>shared</code> 是与其他虚拟机共享的客户"物理"内存量（通过 VMkernel 的透明页面共享机制，一种 RAM 去重技术）。' +
            '有关详细信息，请参阅<a href="https://docs.vmware.com/en/VMware-vSphere/6.5/com.vmware.vsphere.resmgmt.doc/GUID-BFDC988B-F53D-4E97-9793-A002445AFAE1.html" target="_blank">测量和区分内存使用类型</a>和' +
            '<a href="https://vdc-repo.vmware.com/vmwb-repository/dcr-public/fe08899f-1eec-4d8d-b3bc-a6664c168c2c/7fdf97a1-4c0d-4be0-9d43-2ceebbc174d9/doc/memory_counters.html" target="_blank">内存计数器</a>文章。'

    },

    'vsphere.vm_mem_swap_rate': {
        info:
            '此统计信息指的是 VMkernel 交换，而不是客户操作系统交换。' +
            '<code>in</code> 是 VMKernel 从交换文件将数据读入机器内存的速率。' +
