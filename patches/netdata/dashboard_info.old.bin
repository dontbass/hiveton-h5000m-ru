    },

    'system.entropy': {
        colors: '#CC22AA',
        info: '<a href="https://en.wikipedia.org/wiki/Entropy_(computing)" target="_blank">熵</a>是一个主要用于加密的随机数池（<a href="https://en.wikipedia.org/wiki//dev/random" target="_blank">/dev/random</a>）。如果熵池变空，需要随机数的进程可能运行得慢得多（这取决于每个程序使用的接口），等待池被补充。理想情况下，具有高熵需求的系统应该有一个用于此目的的硬件设备（TPM 就是这样一个设备）。还有几个纯软件选项可以安装，如 <code>haveged</code>，尽管这些通常仅在服务器上有用。'
    },

    'system.clock_sync_state': {
        info:'<p>由 <a href="https://man7.org/linux/man-pages/man2/adjtimex.2.html" target="_blank">ntp_adjtime()</a> 系统调用提供的系统时钟同步状态。'+
        '未同步的时钟可能是 NTP 守护进程同步问题或硬件时钟故障的结果。'+
        'NTP 守护进程选择要同步的服务器之前可能需要几分钟（通常最多 17 分钟）。'+
        '<p><b>状态映射</b>：0 - 未同步，1 - 已同步。</p>'
    },

    'system.clock_status': {
        info:'<p>内核代码可以在各种模式下运行，启用或禁用各种功能，由 '+
