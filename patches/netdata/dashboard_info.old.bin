    },

    'ip.tcp_retransmit': {
        info: 'TCP 数据包<a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#tcp-retransmit" target="_blank">重传</a>的次数。' +
        '如果<a href="https://learn.netdata.cloud/guides/troubleshoot/monitor-debug-applications-ebpf" target="_blank">apps</a> 或' +
        '<a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#integration-with-cgroupsplugin" target="_blank">cgroup (systemd 服务)</a>插件启用，Netdata 显示每个<a href="#ebpf_apps_tcp_retransmit">应用程序</a>和<a href="#ebpf_services_tcp_retransmit">cgroup (systemd 服务)</a>的 TCP 重传。' + ebpfChartProvides + '<div id="ebpf_global_tcp_retransmit"></div>'
    },

    'ip.udp_functions': {
        info: '调用负责<a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#udp-functions" target="_blank">交换数据</a>的 UDP 函数的次数。' +
        '如果<a href="https://learn.netdata.cloud/guides/troubleshoot/monitor-debug-applications-ebpf" target="_blank">apps</a> 或' +
