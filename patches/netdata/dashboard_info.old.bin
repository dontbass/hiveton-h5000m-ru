    'k8s_state.node_pods_readiness': {
        info: '准备好为请求提供服务的 Pod 百分比。'
    },
    'k8s_state.node_pods_readiness_state': {
        info: '<p>Pod 就绪状态。</p>'+
        '<p><b>Ready</b> - Pod 已通过其就绪探针并准备好为请求提供服务。'+
        '<b>Unready</b> - Pod 尚未通过其就绪探针。</p>'
    },
    'k8s_state.node_pods_condition': {
        info: '<p>Pod 状态。'+
        '<a href="https://kubernetes.io/docs/concepts/workloads/pods/pod-lifecycle/#pod-conditions" target="_blank">更多信息。</a></p>'+
        '<b>PodReady</b> - Pod 能够为请求提供服务，应该被添加到所有匹配服务的负载均衡池中。'+
        '<b>PodScheduled</b> - Pod 已被调度到节点。'+
        '<b>PodInitialized</b> - 所有初始化容器已成功完成。'+
        '<b>ContainersReady</b> - Pod 中的所有容器都已就绪。</p>'
    },
    'k8s_state.node_pods_phase': {
        info: '<p>Pod 阶段。Pod 的阶段是 Pod 在其生命周期中所处位置的高级摘要。'+
        '<a href="https://kubernetes.io/docs/concepts/workloads/pods/pod-lifecycle/#pod-phase" target="_blank">更多信息。</a></p>'+
        '<p><b>Running</b> - Pod 已绑定到节点，并且所有容器都已创建。'+
        '至少一个容器仍在运行，或正在启动或重新启动过程中。' +
        '<b>Failed</b> - Pod 中的所有容器都已终止，并且至少有一个容器以失败终止。'+
        '也就是说，容器以非零状态退出或被系统终止。' +
        '<b>Succedeed</b> - Pod 中的所有容器都已成功终止，不会重新启动。' +
        '<b>Pending</b> - Pod 已被 Kubernetes 集群接受，但一个或多个容器尚未设置并准备好运行。</p>'
    },
    'k8s_state.node_containers': {
        info: '容器和初始化容器的总数。'
    },
    'k8s_state.node_containers_state': {
        info: '<p>处于不同生命周期状态的容器数。'+
        '<a href="https://kubernetes.io/docs/concepts/workloads/pods/pod-lifecycle/#container-states" target="_blank">更多信息。</a></p>'+
        '<p><b>Running</b> - 容器正在无问题地执行。'+
        '<b>Waiting</b> - 容器仍在运行完成启动所需的操作。'+
        '<b>Terminated</b> - 容器开始执行，然后要么运行完成，要么因某种原因失败。</p>'
    },
    'k8s_state.node_init_containers_state': {
        info: '<p>处于不同生命周期状态的初始化容器数。'+
        '<a href="https://kubernetes.io/docs/concepts/workloads/pods/pod-lifecycle/#container-states" target="_blank">更多信息。</a></p>'+
        '<p><b>Running</b> - 容器正在无问题地执行。'+
        '<b>Waiting</b> - 容器仍在运行完成启动所需的操作。'+
        '<b>Terminated</b> - 容器开始执行，然后要么运行完成，要么因某种原因失败。</p>'
