    },

    // ------------------------------------------------------------------------
    // ntpd

    'ntpd.sys_offset': {
        info: '对于没有任何时间关键服务的主机，即使网络延迟较高，&lt; 100 ms 的偏移应该是可以接受的。对于具有时间关键服务的主机，通过使用低延迟的对等方并配置最佳<b>轮询指数</b>值，可以实现约 0.01 ms 或更小的偏移。',
        colors: NETDATA.colors[4]
    },

    'ntpd.sys_jitter': {
        info: '抖动统计信息是指数加权 RMS 平均值。系统抖动在 NTPv4 规范中定义；时钟抖动统计信息由时钟规程模块计算。'
    },

    'ntpd.sys_frequency': {
        info: '频率偏移以 ppm（百万分之一）表示，相对于系统频率。时钟所需的频率校正可能因启动而显著变化，也可能由于温度或辐射等外部影响而变化。',
        colors: NETDATA.colors[2],
        height: 0.6
    },

    'ntpd.sys_wander': {
        info: '漂移统计信息是指数加权 RMS 平均值。',
        colors: NETDATA.colors[3],
        height: 0.6
    },

    'ntpd.sys_rootdelay': {
        info: 'rootdelay 是到主参考时钟的往返延迟，类似于 <code>ping</code> 命令显示的延迟。较低的延迟应该导致较低的时钟偏移。',
        colors: NETDATA.colors[1]
    },

    'ntpd.sys_stratum': {
        info: '到主参考时钟的"跳数"距离',
        colors: NETDATA.colors[5],
        height: 0.3
    },

    'ntpd.sys_tc': {
        info: '时间常数和轮询间隔以 2 的指数表示。默认轮询指数 6 对应于 64 秒的轮询间隔。对于典型的互联网路径，最佳轮询间隔约为 64 秒。对于使用现代计算机的快速局域网，轮询指数 4（16 秒）是合适的。<a href="http://doc.ntp.org/current-stable/poll.html" target="_blank">轮询过程</a>按时钟规程算法确定的间隔发送 NTP 数据包。',
        height: 0.5
    },

    'ntpd.sys_precision': {
        colors: NETDATA.colors[6],
        height: 0.2
    },

    'ntpd.peer_offset': {
        info: '对等时钟相对于系统时钟的偏移（以毫秒为单位）。较小的值在本地时钟初始同步后对对等选择的权重更大。对于向其他系统提供时间服务的系统，这些值应尽可能低。'
    },

    'ntpd.peer_delay': {
        info: '与对等方通信的往返时间（RTT），类似于 <code>ping</code> 命令显示的延迟。虽然不如偏移或抖动那么关键，但仍被纳入选择算法（因为作为一般规则，较低的延迟意味着更准确的时间）。在大多数情况下，它应该低于 100ms。'
    },

    'ntpd.peer_dispersion': {
        info: '这是对等方与本地系统之间估计误差的度量。此处较低的值更好。'
    },

    'ntpd.peer_jitter': {
        info: '这本质上是对等方的 <code>system_jitter</code> 值的远程估计。此处较低的值在对等选择中权重很高，这是给定时间服务器整体质量的良好指标（好的服务器此处的值不会超过个位数毫秒，高质量的 stratum 1 服务器通常具有亚毫秒级抖动）。'
    },

    'ntpd.peer_xleave': {
        info: '此变量在交错模式中使用（仅在 NTP 对称和广播模式中使用）。请参阅 <a href="http://doc.ntp.org/current-stable/xleave.html" target="_blank">NTP 交错模式</a>。'
    },

    'ntpd.peer_rootdelay': {
        info: '对于 stratum 1 服务器，这是参考时钟的访问延迟。对于较低层级服务器，它是它们正在同步的系统的 <code>peer_delay</code> 和 <code>peer_rootdelay</code> 的总和。与 <code>peer_delay</code> 类似，此处较低的值在技术上更好，但对对等选择的影响有限。'
    },

    'ntpd.peer_rootdisp': {
        info: '与 <code>peer_rootdelay</code> 相同，但测量累积的 <code>peer_dispersion</code> 而不是累积的 <code>peer_delay</code>。'
    },

    'ntpd.peer_hmode': {
        info: '<code>peer_hmode</code> 和 <code>peer_pmode</code> 变量提供有关发送到给定对等方和从给定对等方接收的数据包处于什么模式的信息。模式 1 是对称主动（本地系统和远程对等方都在 <code>/etc/ntp.conf</code> 中将彼此声明为对等方），模式 2 是对称被动（只有一方将另一方声明为对等方），模式 3 是客户端，模式 4 是服务器，模式 5 是广播（也用于多播和任播操作）。',
        height: 0.2
    },

    'ntpd.peer_pmode': {
        height: 0.2
    },

    'ntpd.peer_hpoll': {
        info: '<code>peer_hpoll</code> 和 <code>peer_ppoll</code> 变量是轮询间隔（以秒为单位）的 log2 表示。',
        height: 0.5
    },

    'ntpd.peer_ppoll': {
        height: 0.5
    },

    'ntpd.peer_precision': {
        height: 0.2
    },

    'spigotmc.tps': {
        info: '运行的 1、5 和 15 分钟平均服务器每秒滴答数。理想化的服务器将为所有值显示 20.0，但实际上这几乎从未发生。典型服务器应在此处显示约 19.98-20.0。较低的值表示服务器端延迟逐渐增加（因此您需要为服务器配备更好的硬件或降低用户限制）。每低于 20 的 0.05 滴答，红石时钟将滞后约 0.25%。低于约 19.50 的值可能会干扰复杂的自由运行红石电路，并会明显减慢增长速度。'
    },

    'spigotmc.users': {
        info: '被监控的 Spigot 服务器上当前连接的用户数。'
    },

    'boinc.tasks': {
        info: '任务总数和活动任务数。活动任务是当前正在处理或部分处理但已暂停的任务。'
    },

    'boinc.states': {
        info: '每个任务状态中的任务计数。正常的状态序列是 <code>New</code>、<code>Downloading</code>、<code>Ready to Run</code>、<code>Uploading</code>、<code>Uploaded</code>。标记为 <code>Ready to Run</code> 的任务可能正在主动运行，或者可能正在等待调度。<code>Compute Errors</code> 是在执行期间因某种原因失败的任务。<code>Aborted</code> 任务已手动取消，不会被处理。<code>Failed Uploads</code> 是原本已完成但上传到服务器失败的任务，通常表明存在网络问题。'
    },

    'boinc.sched': {
        info: '每个调度状态中的活动任务计数。<code>Scheduled</code> 任务是如果系统允许处理任务将运行的任务。<code>Preempted</code> 任务处于待命状态，如果 <code>Scheduled</code> 任务因某种原因停止运行，它们将运行。<code>Uninitialized</code> 任务应该永远不会出现，并表明调度器尚未尝试调度它们。'
    },

    'boinc.process': {
        info: '每个进程状态中的活动任务计数。<code>Executing</code> 任务正在立即运行。<code>Suspended</code> 任务有关联的进程，但当前未运行（要么是因为系统当前未处理任何任务，要么是因为它们已被更高优先级的任务抢占）。<code>Quit</code> 任务正在优雅退出。<code>Aborted</code> 任务超出了某些资源限制，正在被关闭。<code>Copy Pending</code> 任务正在等待后台文件传输完成。<code>Uninitialized</code> 任务尚未有关联的进程。'
    },

    'w1sensor.temp': {
        info: '从 1-Wire 温度传感器派生的温度。'
    },

    'logind.sessions': {
        info: '本地和远程会话。'
    },
    'logind.sessions_type': {
        info: '<p>每种会话类型的会话。</p><p><b>Graphical</b> - 会话在 X11、Mir 或 Wayland 之一下运行。<b>Console</b> - 会话通常是常规文本模式本地登录，但根据系统配置方式可能有关联的 GUI。<b>Other</b> - 会话是不属于上述类别的会话（例如 cron 作业或 systemd 计时器单元的会话）。</p>'
    },
    'logind.sessions_state': {
        info: '<p>每个会话状态中的会话。</p><p><b>Online</b> - 已登录并在后台运行。<b>Closing</b> - 名义上已注销，但属于它的某些进程仍然存在。<b>Active</b> - 已登录并在前台运行。</p>'
    },
    'logind.users_state': {
        info: '<p>每个用户状态中的用户。</p><p><b>Offline</b> - 用户未登录。<b>Closing</b> - 用户正在注销过程中，没有逗留。<b>Online</b> - 用户已登录，但没有活动会话。<b>Lingering</b> - 用户未登录，但仍有一项或多项服务正在运行。<b>Active</b> - 用户已登录，并且至少有一个活动会话。</p>'
    },

    // ------------------------------------------------------------------------
    // ProxySQL

    'proxysql.pool_status': {
        info: '后端服务器的状态。 ' +
            '<code>1=ONLINE</code> 后端服务器完全可操作，' +
            '<code>2=SHUNNED</code> 后端服务器暂时停用，因为在太短的时间内连接错误过多，或复制延迟超过了允许的阈值，' +
            '<code>3=OFFLINE_SOFT</code> 当服务器进入 OFFLINE_SOFT 模式时，不再接受新的传入连接，而现有连接保持到它们变为非活动状态。换句话说，连接保持使用直到当前事务完成。这允许优雅地分离后端，' +
            '<code>4=OFFLINE_HARD</code> 当服务器进入 OFFLINE_HARD 模式时，现有连接被丢弃，同时也不接受新的传入连接。这相当于从主机组中删除服务器，或暂时将其从主机组中取出进行维护工作，' +
            '<code>-1</code> 未知状态。'
    },

    'proxysql.pool_net': {
        info: '发送到/从后端接收的数据量 ' +
            '（这不包括元数据（数据包头、OK/ERR 数据包、字段描述等））。'
    },

    'proxysql.pool_overall_net': {
        info: '发送到/从所有后端接收的数据量 ' +
            '（这不包括元数据（数据包头、OK/ERR 数据包、字段描述等））。'
    },

    'proxysql.questions': {
        info: '<code>questions</code> 从前端发送的查询总数，' +
            '<code>slow_queries</code> 运行时间超过全局变量 <code>mysql-long_query_time</code> 中定义的阈值（以毫秒为单位）的查询数。'
    },

    'proxysql.connections': {
        info: '<code>aborted</code> 由于无效凭据或达到 max_connections 而中止的前端连接数，' +
            '<code>connected</code> 当前连接的前端连接数，' +
            '<code>created</code> 创建的前端连接数，' +
            '<code>non_idle</code> 当前非空闲的前端连接数。'
    },

    'proxysql.pool_latency': {
