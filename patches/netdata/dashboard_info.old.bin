    },

    'cockroachdb.live_nodes': {
        info: '如果此节点本身不是活动的，将为 <code>0</code>。'
    },

    'cockroachdb.total_storage_capacity': {
        info: '整个磁盘容量。它包括非 CR 数据、CR 数据和空闲空间。'
    },

    'cockroachdb.storage_capacity_usability': {
        info: '<code>usable</code> 是空闲空间和 CR 数据的总和，<code>unusable</code> 是非 CR 数据使用的空间。'
    },

    'cockroachdb.storage_usable_capacity': {
        info: '<code>usable</code> 空间的细分。'
    },

    'cockroachdb.storage_used_capacity_percentage': {
        info: '<code>total</code> 是已使用<b>总</b>空间的百分比，<code>usable</code> 是已使用<b>可用</b>空间的百分比。'
    },

    'cockroachdb.sql_bandwidth': {
        info: 'SQL 客户端网络流量总量。'
    },

    'cockroachdb.sql_errors': {
        info: '<code>statement</code> 是导致计划或运行时错误的语句，' +
            '<code>transaction</code> 是 SQL 事务中止错误。'
    },

    'cockroachdb.sql_started_ddl_statements': {
        info: '<b>已启动</b>的 DDL（数据定义语言）语句数。' +
            '此类型意味着数据库架构更改。' +
            '它包括 <code>CREATE</code>、<code>ALTER</code>、<code>DROP</code>、<code>RENAME</code>、<code>TRUNCATE</code> 和 <code>COMMENT</code> 语句。'
    },

    'cockroachdb.sql_executed_ddl_statements': {
        info: '<b>已执行</b>的 DDL（数据定义语言）语句数。' +
            '此类型意味着数据库架构更改。' +
            '它包括 <code>CREATE</code>、<code>ALTER</code>、<code>DROP</code>、<code>RENAME</code>、<code>TRUNCATE</code> 和 <code>COMMENT</code> 语句。'
    },

    'cockroachdb.sql_started_dml_statements': {
        info: '<b>已启动</b>的 DML（数据操作语言）语句数。'
    },

    'cockroachdb.sql_executed_dml_statements': {
        info: '<b>已执行</b>的 DML（数据操作语言）语句数。'
    },

    'cockroachdb.sql_started_tcl_statements': {
        info: '<b>已启动</b>的 TCL（事务控制语言）语句数。'
    },

    'cockroachdb.sql_executed_tcl_statements': {
        info: '<b>已执行</b>的 TCL（事务控制语言）语句数。'
    },

    'cockroachdb.live_bytes': {
        info: '应用程序和 CockroachDB 系统使用的活动数据量。'
    },

    'cockroachdb.kv_transactions': {
        info: 'KV 事务细分：<br>' +
            '<ul>' +
            ' <li><code>committed</code> 已提交的 KV 事务（包括 1PC）。</li>' +
            ' <li><code>fast-path_committed</code> KV 事务单阶段提交尝试。</li>' +
            ' <li><code>aborted</code> 已中止的 KV 事务。</li>' +
            ' </ul>'
    },

    'cockroachdb.kv_transaction_restarts': {
        info: 'KV 事务重启细分：<br>' +
            '<ul>' +
            ' <li><code>write too old</code> 由于并发写入者首先提交而重启。</li>' +
            ' <li><code>write too old (multiple)</code> 由于多个并发写入者首先提交而重启。</li>' +
            ' <li><code>forwarded timestamp (iso=serializable)</code> 由于转发的提交时间戳和 isolation=SERIALIZABLE 而重启。</li>' +
            ' <li><code>possible replay</code> 由于存储层可能重放命令批次而重启。</li>' +
            ' <li><code>async consensus failure</code> 由于未能留下意图的异步共识写入而重启。</li>' +
            ' <li><code>read within uncertainty interval</code> 由于在不确定性间隔内读取新值而重启。</li>' +
            ' <li><code>aborted</code> 由于并发事务中止（通常由于死锁）而重启。</li>' +
            ' <li><code>push failure</code> 由于事务推送失败而重启。</li>' +
            ' <li><code>unknown</code> 由于未知原因而重启。</li>' +
            ' </ul>'
    },

    'cockroachdb.ranges': {
        info: 'CockroachDB 在一个巨大的键值对排序映射中存储所有用户数据（表、索引等）和几乎所有系统数据。' +
            '此键空间被划分为"范围"，即键空间的连续块，以便始终可以在单个范围中找到每个键。'
    },

    'cockroachdb.ranges_replication_problem': {
        info: '副本数量不理想的范围：<br>' +
            '<ul>' +
            ' <li><code>unavailable</code> 活动副本少于仲裁所需数量的范围。</li>' +
            ' <li><code>under replicated</code> 活动副本少于复制目标的范围。</li>' +
            ' <li><code>over replicated</code> 活动副本多于复制目标的范围。</li>' +
            ' </ul>'
    },

    'cockroachdb.replicas': {
        info: 'CockroachDB 复制每个范围（默认为 3 次）并将每个副本存储在不同的节点上。'
    },

    'cockroachdb.replicas_leaders': {
        info: '对于每个范围，其中一个副本是写入请求的 <code>leader</code>，<code>not leaseholders</code> 是范围租约由另一个存储持有的 Raft 领导者数。'
    },

    'cockroachdb.replicas_leaseholders': {
        info: '对于每个范围，其中一个副本持有"范围租约"。此副本称为 <code>leaseholder</code>，是接收和协调范围所有读写请求的副本。'
    },

    'cockroachdb.queue_processing_failures': {
        info: '按队列细分的失败副本：<br>' +
            '<ul>' +
            ' <li><code>gc</code> 在 GC 队列中处理失败的副本。</li>' +
            ' <li><code>replica gc</code> 在副本 GC 队列中处理失败的副本。</li>' +
            ' <li><code>replication</code> 在复制队列中处理失败的副本。</li>' +
            ' <li><code>split</code> 在拆分队列中处理失败的副本。</li>' +
            ' <li><code>consistency</code> 在一致性检查器队列中处理失败的副本。</li>' +
            ' <li><code>raft log</code> 在 Raft 日志队列中处理失败的副本。</li>' +
            ' <li><code>raft snapshot</code> 在 Raft 修复队列中处理失败的副本。</li>' +
            ' <li><code>time series maintenance</code> 在时间序列维护队列中处理失败的副本。</li>' +
            ' </ul>'
    },

    'cockroachdb.rebalancing_queries': {
        info: '存储每秒接收的 kv 级请求数，在重新平衡决策中使用的长时间段内平均。'
    },

    'cockroachdb.rebalancing_writes': {
        info: '每秒写入存储的键数（即由 raft 应用），在重新平衡决策中使用的长时间段内平均。'
    },

    'cockroachdb.slow_requests': {
        info: '已卡住很长时间的请求。'
    },

    'cockroachdb.timeseries_samples': {
        info: '写入磁盘的指标样本量。'
    },

    'cockroachdb.timeseries_write_errors': {
        info: '尝试将指标写入磁盘时遇到的错误数量。'
