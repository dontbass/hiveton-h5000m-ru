    },

    'system.processes': {
        info: '<p>系统进程。</p>'+
        '<p><b>Running</b> - 正在运行或准备运行（可运行）。'+
        '<b>Blocked</b> - 当前已阻塞，等待 I/O 完成。</p>'
    },

    'system.processes_state': {
        info: '<p>处于不同状态的进程数。</p>'+
        '<p><b>Running</b> - 在特定时刻使用 CPU 的进程。'+
        '<b>Sleeping (uninterruptible)</b> - 当等待的资源可用或在等待期间发生超时后，进程将唤醒。'+
        '主要由等待磁盘或网络 I/O 的设备驱动程序使用。'+
        '<b>Sleeping (interruptible)</b> - 进程正在等待特定时间段或特定事件发生。'+
        '<b>Zombie</b> - 已完成执行、释放系统资源但其条目未从进程表中删除的进程。'+
        '通常发生在子进程中，当父进程仍需要读取其子进程的退出状态时。'+
        '长时间保持僵尸状态的进程通常是错误，会导致系统 PID 空间泄漏。'+
        '<b>Stopped</b> - 由于 STOP 或 TSTP 信号而暂停继续进行的进程。' +
        '在这种状态下，进程将不会做任何事情（甚至不会终止），直到它接收到 CONT 信号。</p>'
    },

    'system.active_processes': {
        info: '系统中的进程总数。'
    },

    'system.ctxt': {
        info: '<a href="https://en.wikipedia.org/wiki/Context_switch" target="_blank">上下文切换</a>是 CPU 从一个进程、任务或线程切换到另一个的过程。如果有许多进程或线程愿意执行而可用于处理它们的 CPU 核心很少，系统会进行更多的上下文切换以在它们之间平衡 CPU 资源。整个过程是计算密集型的。上下文切换越多，系统就越慢。'
    },

    'system.idlejitter': {
        title: 'CPU 空闲抖动',
        info: '空闲抖动由 netdata 计算。生成一个线程，请求休眠几微秒。当系统唤醒它时，它会测量已经过了多少微秒。请求的休眠时长与实际休眠时长之间的差异就是<b>空闲抖动</b>。这个数字在实时环境中很有用，其中 CPU 抖动会影响服务质量（如 VoIP 媒体网关）。'
    },

    'system.net': {
