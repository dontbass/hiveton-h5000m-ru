    'netfilter.conntrack_new': {
        info: '<p>新数据包的跟踪统计信息。'+
        '<p><b>New</b> - 添加的之前未预期的连接跟踪数据包。'+
        '<b>Ignore</b> - 已连接到连接跟踪的数据包。'+
        '<b>Invalid</b> - 无法跟踪的数据包。</p>'
    },

    'netfilter.conntrack_changes': {
        info: '<p>连接跟踪表中的更改数。</p>'+
        '<p><b>Inserted</b>、<b>Deleted</b> - 插入或删除的连接跟踪数据包。'+
        '<b>Delete-list</b> - 放入删除列表的连接跟踪数据包。</p>'
    },

    'netfilter.conntrack_expect': {
        info: '<p>连接跟踪预期事件数。'+
        '连接跟踪预期是用于"预期"与现有连接相关的 RELATED 连接的机制。'+
        '预期是预期在一段时间内发生的连接。</p>'+
        '<p><b>Created</b>、<b>Deleted</b> - 插入或删除的连接跟踪预期数据包。'+
        '<b>New</b> - 在已存在预期后添加的连接跟踪数据包。</p>'
    },

    'netfilter.conntrack_search': {
        info: '<p>连接跟踪表查找统计信息。</p>'+
        '<p><b>Searched</b> - 执行的连接跟踪表查找。'+
        '<b>Restarted</b> - 由于哈希表调整大小而必须重新启动的连接跟踪表查找。'+
        '<b>Found</b> - 成功的连接跟踪表查找。</p>'
    },

    'netfilter.conntrack_errors': {
        info: '<p>连接跟踪错误。</p>'+
        '<p><b>IcmpError</b> - 由于错误情况而无法跟踪的数据包。'+
        '<b>InsertFailed</b> - 尝试列表插入但失败的条目'+
        '（如果相同条目已存在则会发生）。'+
        '<b>Drop</b> - 由于连接跟踪失败而丢弃的数据包。'+
        '要么新的连接跟踪数据包分配失败，要么协议助手丢弃了数据包。'+
        '<b>EarlyDrop</b> - 如果达到最大表大小，为新数据包腾出空间而丢弃的连接跟踪数据包。</p>'
    },

    'netfilter.synproxy_syn_received': {
        info: '从客户端接收的初始 TCP SYN 数据包数。'
    },

    'netfilter.synproxy_conn_reopened': {
        info: '直接从 TIME-WAIT 状态通过新 TCP SYN 数据包重新打开的连接数。'
    },

    'netfilter.synproxy_cookies': {
        info: '<p>SYNPROXY cookie 统计信息。</p>'+
