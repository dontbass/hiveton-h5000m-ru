    },

    'net.compressed': {
        title: '压缩数据包'
    },

    'net.events': {
        title: '网络事件'
    },

    'web_log.squid_bandwidth': {
        title: '带宽',
        info: 'squid 响应的带宽（<code>sent</code>）。此图表可能会出现异常峰值，因为带宽是在服务器保存日志行时计算的，即使服务所需的时间跨越更长的持续时间。我们建议使用 QoS（例如 <a href="http://firehol.org/#fireqos" target="_blank">FireQOS</a>）来准确计算服务器带宽。'
    },

    'web_log.squid_responses': {
        title: '响应',
        info: '与 squid 发送的响应相关的信息。'
    },

    'web_log.squid_requests': {
        title: '请求',
        info: '与 squid 接收的请求相关的信息。'
    },

    'web_log.squid_hierarchy': {
        title: '层次结构',
        info: '用于处理请求的 squid 层次结构的性能指标。'
    },

    'web_log.squid_squid_transport': {
        title: '传输'
    },

    'web_log.squid_squid_cache': {
        title: '缓存',
        info: 'squid 缓存性能的性能指标。'
    },

    'web_log.squid_timings': {
        title: '时间',
        info: 'squid 请求的持续时间。可能会报告不切实际的峰值，因为 squid 会在请求完成时记录请求的总时间。特别是对于 HTTPS，客户端从代理获取隧道并直接与上游服务器交换请求，因此 squid 无法评估单个请求并报告隧道打开的总时间。'
    },

    'web_log.squid_clients': {
        title: '客户端'
    },

    'web_log.bandwidth': {
        title: '带宽',
        info: '请求（<code>received</code>）和响应（<code>sent</code>）的带宽。<code>received</code> 需要扩展日志格式（没有它，Web 服务器日志没有此信息）。此图表可能会出现异常峰值，因为带宽是在 Web 服务器保存日志行时计算的，即使服务所需的时间跨越更长的持续时间。我们建议使用 QoS（例如 <a href="http://firehol.org/#fireqos" target="_blank">FireQOS</a>）来准确计算 Web 服务器带宽。'
    },

    'web_log.urls': {
        title: 'URL 请求数',
        info: '在 <a href="https://github.com/netdata/go.d.plugin/blob/master/config/go.d/web_log.conf" target="_blank"><code>/etc/netdata/go.d/web_log.conf</code></a> 中定义的每个 <code>URL 模式</code>的请求数。此图表计算所有与定义的 URL 模式匹配的请求，与 Web 服务器响应代码无关（即成功和失败的请求都计入）。'
    },

    'web_log.clients': {
        title: '客户端',
        info: '显示访问 Web 服务器的唯一客户端 IP 数量的图表。'
    },

    'web_log.timings': {
        title: '响应时间',
        info: 'Web 服务器响应时间 - Web 服务器准备和响应请求所需的时间。这需要扩展的日志格式，其含义特定于 Web 服务器。对于大多数 Web 服务器，这计算从接收完整请求到发送响应的最后一个字节的时间。因此，它包括响应的网络延迟，但不包括请求的网络延迟。'
    },

    'mem.ksm': {
        title: '内存去重 (ksm)',
        info: '<a href="https://en.wikipedia.org/wiki/Kernel_same-page_merging" target="_blank">内核同页合并</a> '+
        '(KSM) 性能监控，从 <code>/sys/kernel/mm/ksm/</code> 中的多个文件读取。'+
        'KSM 是 Linux 内核中的内存节省去重功能。'+
        'KSM 守护进程 ksmd 定期扫描已注册的用户内存区域，'+
        '寻找内容相同的页面，这些页面可以被单个写保护页面替换。'
    },

    'mem.hugepages': {
        title: '内存大页',
        info: 'Hugepages（大页）是一个允许内核利用现代硬件架构的多种页面大小功能的特性。内核创建多个虚拟内存页面，从物理 RAM 和交换空间映射。CPU 架构中有一个称为"转换后备缓冲器"(TLB) 的机制来管理虚拟内存页面到实际物理内存地址的映射。TLB 是有限的硬件资源，因此使用默认页面大小的大量物理内存会消耗 TLB 并增加处理开销。通过使用大页，内核能够创建更大尺寸的页面，每个页面仅消耗 TLB 中的单个资源。大页被固定到物理 RAM，不能被交换/换出。'
    },

    'mem.numa': {
        title: '非统一内存',
        info: '非统一内存访问 (NUMA) 是一种分层内存设计，内存访问时间取决于位置。在 NUMA 下，处理器访问自己的本地内存比访问非本地内存（另一个处理器的本地内存或处理器之间共享的内存）更快。各个指标在 <a href="https://www.kernel.org/doc/Documentation/numastat.txt" target="_blank">Linux 内核文档</a>中有描述。'
    },

    'mem.ecc': {
        title: '内存纠错',
        info: '<p><a href="https://en.wikipedia.org/wiki/ECC_memory" target="_blank">ECC 内存</a>'+
        '是一种使用错误纠正码 (ECC) 来检测和纠正内存中发生的 n 位数据损坏的计算机数据存储类型。'+
        '通常，ECC 内存维护对单位错误免疫的内存系统：'+
        '从每个字读取的数据始终与写入它的数据相同，'+
        '即使实际存储的某个位已翻转到错误状态。</p>'+
        '<p>内存错误可分为两种类型：'+
        '<b>软错误</b>，随机损坏位但不留下物理损坏。'+
        '软错误本质上是瞬态的，不可重复，可能是由于电气或磁干扰造成的。'+
        '<b>硬错误</b>，以可重复的方式损坏位，因为物理/硬件缺陷或环境问题。'
    },

    'mem.pagetype': {
        title: '页类型',
        info: '来自<a href="https://en.wikipedia.org/wiki/Buddy_memory_allocation" target="_blank">伙伴内存分配器</a>的可用空闲内存统计信息。'+
        '伙伴分配器是系统内存分配器。'+
        '整个内存空间被分割成物理页面，这些页面按 NUMA 节点、区域、'+
        '<a href="https://lwn.net/Articles/224254/" target="_blank">迁移类型</a>和块大小分组。'+
        '通过根据页面移动能力对页面进行分组，'+
        '内核可以回收页面块内的页面以满足高阶分配。'+
        '当内核或应用程序请求一些内存时，伙伴分配器提供最接近请求的页面。'
    },

    'ip.ecn': {
        title: '显式拥塞通知',
        info: '<a href="https://en.wikipedia.org/wiki/Explicit_Congestion_Notification" target="_blank">显式拥塞通知 (ECN)</a> '+
        '是 IP 和 TCP 的扩展，允许在不丢弃数据包的情况下进行网络拥塞的端到端通知。'+
        'ECN 是一个可选功能，当底层网络基础设施也支持时，可以在两个启用 ECN 的端点之间使用。'
    },

    'ip.multicast': {
        title: 'IP 组播',
        info: '<a href="https://en.wikipedia.org/wiki/Multicast" target="_blank">IP 组播</a>是一种在 IP 网络上进行一对多通信的技术。'+
        '组播通过要求源仅发送一次数据包来高效使用网络基础设施，'+
        '即使需要将其传递给大量接收者。'+
        '网络中的节点仅在必要时负责复制数据包以到达多个接收者。'
    },

    'ip.errors': {
        title: '错误'
    },

    'ip.tcp': {
        title: 'TCP'
    },

    'ip.broadcast': {
        title: 'IP 广播',
        info: '在计算机网络中，'+
        '<a href="https://en.wikipedia.org/wiki/Broadcasting_(networking)" target="_blank">广播</a>是指传输将被网络上每个设备接收的数据包。'+
        '实际上，广播的范围限于广播域。'
    },

    'netfilter.conntrack': {
        title: '连接跟踪器',
        info: 'Netfilter 连接跟踪器性能指标。连接跟踪器跟踪机器的所有入站和出站连接。它通过保存包含所有打开连接的数据库来工作，跟踪网络和地址转换以及连接预期。'
    },

    'netfilter.nfacct': {
        title: '带宽统计',
        info: '使用 <code>nfacct.plugin</code> 读取以下信息。'
    },

    'netfilter.synproxy': {
        title: 'DDoS 防护',
        info: 'DDoS 防护性能指标。<a href="https://github.com/firehol/firehol/wiki/Working-with-SYNPROXY" target="_blank">SYNPROXY</a> '+
        '是一个 TCP SYN 数据包代理。'+
        '它用于保护任何 TCP 服务器（如 Web 服务器）免受 SYN 洪水和类似的 DDoS 攻击。'+
        'SYNPROXY 拦截新的 TCP 连接并使用 syncookies 处理初始的三次握手，'+
        '而不是使用 conntrack 来建立连接。'+
        '它经过优化，可以利用所有可用的 CPU 每秒处理数百万个数据包，而无需在连接之间进行任何并发锁定。'+
        '它可以用于任何类型的 TCP 流量（甚至是加密的），'+
        '因为它不会干扰内容本身。'
    },

    'ipfw.dynamic_rules': {
        title: '动态规则',
        info: '由相应的有状态防火墙规则创建的动态规则数量。'
    },

    'system.softnet_stat': {
        title: '软中断网络',
        info: function (os) {
            if (os === 'linux')
                return '<p>与网络接收工作相关的 CPU 软中断统计信息。'+
                '每个 CPU 核心的详细信息可以在 <a href="#menu_cpu_submenu_softnet_stat">CPU / softnet 统计</a>中找到。'+
                '有关识别和排除网络驱动程序相关问题的更多信息，请参阅 '+
                '<a href="https://access.redhat.com/sites/default/files/attachments/20150325_network_performance_tuning.pdf" target="_blank">Red Hat Enterprise Linux 网络性能调优指南</a>。</p>'+
                '<p><b>Processed</b> - 已处理的数据包。'+
                '<b>Dropped</b> - 因网络设备积压已满而丢弃的数据包。'+
                '<b>Squeezed</b> - 网络设备预算已耗尽或达到时间限制但仍有更多工作可用的次数。'+
                '<b>ReceivedRPS</b> - 通过处理器间中断唤醒此 CPU 来处理数据包的次数。'+
                '<b>FlowLimitCount</b> - 达到流量限制的次数（流量限制是接收数据包转向功能的可选项）。</p>';
            else
                return '与网络接收工作相关的 CPU 软中断统计信息。';
        }
    },

    'system.clock synchronization': {
        title: '时钟同步',
        info: '<a href="https://en.wikipedia.org/wiki/Network_Time_Protocol" target="_blank">NTP</a>'+
        '允许您自动将系统时间与远程服务器同步。'+
        '这通过与已知具有准确时间的服务器同步来保持您的机器时间准确。'
    },

    'cpu.softnet_stat': {
        title: '软中断网络',
        info: function (os) {
            if (os === 'linux')
                return '<p>与网络接收工作相关的 CPU 软中断统计信息。'+
                '所有 CPU 核心的总计可以在 <a href="#menu_system_submenu_softnet_stat">系统 / softnet 统计</a>中找到。'+
                '有关识别和排除网络驱动程序相关问题的更多信息，请参阅 '+
                '<a href="https://access.redhat.com/sites/default/files/attachments/20150325_network_performance_tuning.pdf" target="_blank">Red Hat Enterprise Linux 网络性能调优指南</a>。</p>'+
                '<p><b>Processed</b> - 已处理的数据包。'+
                '<b>Dropped</b> - 因网络设备积压已满而丢弃的数据包。'+
                '<b>Squeezed</b> - 网络设备预算已耗尽或达到时间限制但仍有更多工作可用的次数。'+
                '<b>ReceivedRPS</b> - 通过处理器间中断唤醒此 CPU 来处理数据包的次数。'+
                '<b>FlowLimitCount</b> - 达到流量限制的次数（流量限制是接收数据包转向功能的可选项）。</p>';
            else
                return '每个 CPU 核心的与网络接收工作相关的软中断统计信息。所有 CPU 核心的总计可以在 <a href="#menu_system_submenu_softnet_stat">系统 / softnet 统计</a>中找到。';
        }
    },

    'go_expvar.memstats': {
        title: '内存统计',
        info: 'Go 运行时内存统计信息。有关每个图表和值的更多信息，请参阅 <a href="https://golang.org/pkg/runtime/#MemStats" target="_blank">runtime.MemStats</a> 文档。'
    },

    'couchdb.dbactivity': {
        title: '数据库活动',
        info: '整个服务器的总体数据库读取和写入。这包括任何外部 HTTP 流量，以及在集群中执行的内部复制流量以确保节点一致性。'
    },

    'couchdb.httptraffic': {
        title: 'HTTP 流量分析',
        info: '所有 HTTP 流量，按请求类型（<tt>GET</tt>、<tt>PUT</tt>、<tt>POST</tt> 等）和响应状态码（<tt>200</tt>、<tt>201</tt>、<tt>4xx</tt> 等）细分。<br/><br/>此处的任何 <tt>5xx</tt> 错误都表明可能存在 CouchDB 错误；请检查日志文件以获取更多信息。'
    },

    'couchdb.ops': {
        title: '服务器操作'
    },

    'couchdb.perdbstats': {
        title: '每个数据库统计',
        info: '每个数据库的统计信息。这包括<a href="http://docs.couchdb.org/en/latest/api/database/common.html#get--db" target="_blank">每个数据库的 3 个大小图表</a>：active（数据库中实时数据的大小）、external（数据库内容的未压缩大小）和 file（磁盘上文件的大小，不包括任何视图和索引）。它还包括每个数据库的文档数量和已删除文档数量。'
    },

    'couchdb.erlang': {
        title: 'Erlang 统计',
        info: '有关托管 CouchDB 的 Erlang VM 状态的详细信息。这些仅供高级用户使用。峰值消息队列的高值（>10e6）通常表示过载情况。'
    },

    'ntpd.system': {
        title: '系统',
        info: '由 readlist billboard <code>ntpq -c rl</code> 显示的系统变量统计信息。系统变量被分配关联 ID 为零，也可以在 readvar billboard <code>ntpq -c "rv 0"</code> 中显示。这些变量在<a href="http://doc.ntp.org/current-stable/discipline.html" target="_blank">时钟规则算法</a>中使用，用于计算最低和最稳定的偏移量。'
    },

    'ntpd.peers': {
        title: '对等节点',
        info: '在 <code>/etc/ntp.conf</code> 中配置的每个对等节点的对等变量统计信息，如 readvar billboard <code>ntpq -c "rv &lt;association&gt;"</code> 所示，而每个对等节点被分配一个非零关联 ID，如 <code>ntpq -c "apeers"</code> 所示。该模块定期扫描新的/更改的对等节点（默认：每 60 秒）。<b>ntpd</b> 从可用对等节点中选择最佳对等节点来同步时钟。至少需要 3 个对等节点才能正确识别最佳对等节点。'
    },

    'mem.page_cache': {
        title: '页缓存 (eBPF)',
        info: '用于操作 <a href="https://en.wikipedia.org/wiki/Page_cache" target="_blank">Linux 页缓存</a>的<a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#memory" target="_blank">函数</a>调用次数。此图表与<a href="#menu_filesystem">文件系统</a>、<a href="#menu_mem_submenu_synchronization__eBPF_">同步</a>和<a href="#menu_disk">硬盘</a>有关。'
    },

