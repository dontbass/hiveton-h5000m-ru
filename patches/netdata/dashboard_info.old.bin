    },

    'ip.tcp_functions': {
        info: '调用负责<a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#tcp-bandwidth-functions" target="_blank">交换数据</a>的 TCP 函数的次数。' +
