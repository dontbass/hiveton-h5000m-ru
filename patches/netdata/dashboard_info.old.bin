    },

    'ip.tcp_error': {
        info: '负责 <a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#tcp-bandwidth" target="_blank">TCP 带宽</a>的 TCP 函数的失败调用次数。' +
        '如果<a href="https://learn.netdata.cloud/guides/troubleshoot/monitor-debug-applications-ebpf" target="_blank">apps</a> 或' +
