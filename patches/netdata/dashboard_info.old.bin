// ----------------------------------------------------------------------------
// chart

// information works on the context of a chart
// Its purpose is to set:
//
// info: the text above the charts
// heads: the representation of the chart at the top the subsection (second level menu)
// mainheads: the representation of the chart at the top of the section (first level menu)
// colors: the dimension colors of the chart (the default colors are appended)
// height: the ratio of the chart height relative to the default
//

var cgroupCPULimitIsSet = 0;
var cgroupMemLimitIsSet = 0;

const netBytesInfo = '网络接口传输的流量大小。'
const netPacketsInfo = '网络接口传输的数据包数量。' +
    '接收的<a href="https://en.wikipedia.org/wiki/Multicast" target="_blank">组播</a>计数器通常在设备级别计算（与<b>接收</b>不同），因此可能包括未到达主机的数据包。'
const netErrorsInfo = '<p>网络接口遇到的错误数。</p>' +
    '<p><b>入站</b> - 在此接口上接收的错误数据包。' +
    '它包括由于无效长度、CRC、帧对齐和其他错误而丢弃的数据包。' +
    '<b>出站</b> - 传输问题。' +
    '它包括由于载波丢失、FIFO 下溢/下溢、心跳、' +
    '延迟冲突和其他问题导致的帧传输错误。</p>'
const netFIFOInfo = '<p>网络接口遇到的 FIFO 错误数。</p>' +
    '<p><b>入站</b> - 由于不适合主机提供的缓冲区而丢弃的数据包，' +
    '例如，大于 MTU 的数据包或环中的下一个缓冲区不可用于分散传输。' +
    '<b>出站</b> - 由于设备 FIFO 下溢/下溢导致的帧传输错误。' +
    '当设备开始传输帧但无法及时将整个帧传递给发送器进行传输时，会发生此情况。</p>'
const netDropsInfo = '<p>在网络接口级别丢弃的数据包数。</p>' +
    '<p><b>入站</b> - 接收但未处理的数据包，例如由于' +
    '<a href="#_submenu_softnet_stat">softnet 积压</a>溢出、错误/意外的 VLAN 标签、' +
    '未知或未注册的协议、当服务器未配置 IPv6 时的 IPv6 帧。' +
    '<b>出站</b> - 在传输过程中丢弃的数据包，例如由于缺乏资源。</p>'
const netCompressedInfo = '网络接口正确传输的压缩数据包数。' +
    '这些计数器仅对支持数据包压缩的接口（例如 CSLIP、PPP）有意义。'
const netEventsInfo = '<p>网络接口遇到的错误数。</p>' +
    '<p><b>Frames</b> - 由于无效长度、FIFO 溢出、CRC 和帧对齐错误而丢弃的数据包的聚合计数器。' +
    '<b>Collisions</b> - 数据包传输期间的<a href="https://en.wikipedia.org/wiki/Collision_(telecommunications)" target="blank">冲突</a>。' +
    '<b>Carrier</b> - 由于过度冲突、载波丢失、设备 FIFO 下溢/下溢、心跳/SQE 测试错误和延迟冲突导致的帧传输错误的聚合计数器。</p>'
const netDuplexInfo = '<p>网络适配器与其连接的设备<a href="https://en.wikipedia.org/wiki/Autonegotiation" target="_blank">协商</a>的接口最新或当前<a href="https://en.wikipedia.org/wiki/Duplex_(telecommunications)" target="_blank">双工模式</a>。</p>' +
    '<p><b>Unknown</b> - 无法确定双工模式。' +
    '<b>Half duplex</b> - 通信一次只能单向进行。' +
    '<b>Full duplex</b> - 接口能够同时发送和接收数据。</p>'
const netOperstateInfo = '<p>接口的当前<a href="https://datatracker.ietf.org/doc/html/rfc2863" target="_blank">操作状态</a>。</p>' +
    '<p><b>Unknown</b> - 无法确定状态。' +
    '<b>NotPresent</b> - 接口缺少（通常是硬件）组件。' +
    '<b>Down</b> - 接口无法在 L1 上传输数据，例如以太网未插入或接口在管理上已关闭。' +
    '<b>LowerLayerDown</b> - 由于下层接口的状态，接口处于关闭状态。' +
    '<b>Testing</b> - 接口处于测试模式，例如电缆测试。在测试完成之前，它不能用于正常流量。' +
    '<b>Dormant</b> - 接口 L1 已启动，但正在等待外部事件，例如等待协议建立。' +
    '<b>Up</b> - 接口已准备好传递数据包并可以使用。</p>'
const netCarrierInfo = '接口的当前物理链路状态。'
const netSpeedInfo = '网络适配器与其连接的设备<a href="https://en.wikipedia.org/wiki/Autonegotiation" target="_blank">协商</a>的接口最新或当前速度。' +
    '这并不给出网卡的最大支持速度。'
const netMTUInfo = '接口当前配置的<a href="https://en.wikipedia.org/wiki/Maximum_transmission_unit" target="_blank">最大传输单元</a> (MTU) 值。' +
    'MTU 是在单个网络层事务中可以通信的最大协议数据单元的大小。'
