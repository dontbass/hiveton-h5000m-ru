    'disk.ops': {
        info: '已完成的磁盘 I/O 操作。请记住，请求的操作数可能更高，因为系统能够合并彼此相邻的操作（请参阅合并操作图表）。'
    },

    'disk_ext.ops': {
        info: '<p>已完成的丢弃/刷新请求数（合并后）。</p>'+
        '<p><b>Discard</b> 命令通知磁盘哪些数据块不再被视为使用中，因此可以在内部擦除。'+
        '它们对固态硬盘 (SSD) 和精简配置存储很有用。'+
        '丢弃/修剪使 SSD 能够更有效地处理垃圾收集，'+
        '否则会减慢对相关块的未来写操作。</p>'+
        '<p><b>Flush</b> 操作将所有修改的核心内数据（即修改的缓冲区缓存页）传输到磁盘设备，'+
        '以便即使系统崩溃或重启也可以检索所有更改的信息。'+
        '刷新请求由磁盘执行。不跟踪分区的刷新请求。'+
        '在合并之前，刷新操作计为写入。</p>'
    },

    'disk.qops': {
        info: '当前正在进行的 I/O 操作。此指标是快照 - 不是最后一个间隔的平均值。'
    },

    'disk.iotime': {
        height: 0.5,
        info: '所有已完成 I/O 操作的持续时间总和。如果磁盘能够并行执行 I/O 操作，此数字可以超过间隔。'
