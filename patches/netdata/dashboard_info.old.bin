    'disk.svctm': {
        height: 0.5,
        info: '已完成 I/O 操作的平均服务时间。此指标使用磁盘的总繁忙时间和已完成操作的数量计算。如果磁盘能够执行多个并行操作，报告的平均服务时间将具有误导性。'
    },
    'disk.latency_io': {
        height: 0.5,
        info: '磁盘 I/O <a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#disk-latency" target="_blank">延迟</a>是完成 I/O 请求所需的时间。磁盘图表与<a href="#filesystem">文件系统</a>图表有关。此图表基于 ebpf_exporter 的 <a href="https://github.com/cloudflare/ebpf_exporter/blob/master/examples/bio-tracepoints.yaml" target="_blank">bio_tracepoints</a> 工具。' + ebpfChartProvides
