    'disk_ext.avgsz': {
        height: 0.5,
        info: '平均丢弃操作大小。'
    },
    'disk.await': {
        height: 0.5,
        info: '向设备发出的 I/O 请求被服务的平均时间。这包括请求在队列中花费的时间和为它们提供服务所花费的时间。'
