    'ping.host_std_dev_rtt': {
        info: '往返时间（RTT）标准差。每个 ping 的 RTT 与平均 RTT 偏差的平均值。'
    },
    'ping.host_packet_loss': {
        info: '当一个或多个传输的数据包未到达其目的地时，就会发生数据包丢失。通常由数据传输错误、网络拥塞或防火墙阻止引起。路由器和目标主机通常将 ICMP 回显数据包视为较低优先级，因此 ping 测试数据包丢失可能并不总是转化为应用程序数据包丢失。'
    },
    'ping.host_packets': {
        info: '发送和接收的 ICMP 消息数量。如果没有数据包丢失，这些计数器应该相等。'
