    },

    'ip.total_udp_bandwidth': {
        info: '使用 <a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#udp-bandwidth" target="_blank">UDP 内部函数</a>发送和接收的字节总数。' +
        '如果<a href="https://learn.netdata.cloud/guides/troubleshoot/monitor-debug-applications-ebpf" target="_blank">apps</a> 或' +
        '<a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#integration-with-cgroupsplugin" target="_blank">cgroup (systemd 服务)</a>插件启用，Netdata 显示每个<a href="#ebpf_apps_bandwidth_udp_sendmsg">应用程序</a>和<a href="#ebpf_services_bandwidth_udp_sendmsg">cgroup (systemd 服务)</a>的 UDP 带宽指标。' + ebpfChartProvides + '<div id="ebpf_global_bandwidth_udp_sendmsg"></div>'
    },

    'ip.udp_error': {
        info: '负责 <a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#udp-bandwidth" target="_blank">UDP 带宽</a>的 UDP 函数的失败调用次数。' +
        '如果<a href="https://learn.netdata.cloud/guides/troubleshoot/monitor-debug-applications-ebpf" target="_blank">apps</a> 或' +
        '<a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#integration-with-cgroupsplugin" target="_blank">cgroup (systemd 服务)</a>插件启用，Netdata 显示每个<a href="#ebpf_apps_udp_sendmsg_error">应用程序</a>和<a href="#ebpf_services_udp_sendmsg_error">cgroup (systemd 服务)</a>的 UDP 错误。' + ebpfChartProvides + '<div id="ebpf_global_udp_bandwidth_error"></div>'
    },

    'ip.tcpreorders': {
        info: '<p>TCP 通过按正确顺序对数据包进行排序或请求重传乱序数据包来防止乱序数据包。</p>'+
        '<p><b>Timestamp</b> - 使用时间戳选项检测到重新排序。'+
        '<b>SACK</b> - 使用选择性确认算法检测到重新排序。'+
        '<b>FACK</b> - 使用前向确认算法检测到重新排序。'+
        '<b>Reno</b> - 使用快速重传算法检测到重新排序。</p>'
    },

    'ip.tcpofo': {
        info: '<p>TCP 维护一个乱序队列来保存 TCP 通信中的乱序数据包。</p>'+
        '<p><b>InQueue</b> - TCP 层接收到乱序数据包且有足够内存对其进行排队。'+
        '<b>Dropped</b> - TCP 层接收到乱序数据包但没有足够内存，因此丢弃它。'+
        '<b>Merged</b> - 接收到的乱序数据包与前一个数据包有重叠。'+
        '重叠部分将被丢弃。所有这些数据包也将计入 <b>InQueue</b>。'+
        '<b>Pruned</b> - 由于套接字缓冲区溢出而从乱序队列中丢弃的数据包。</p>'
    },

    'ip.tcpsyncookies': {
        info: '<p><a href="https://en.wikipedia.org/wiki/SYN_cookies" target="_blank">SYN cookies</a> '+
        '用于缓解 SYN 洪水攻击。</p>'+
        '<p><b>Received</b> - 发送 SYN cookie 后，它返回给我们并通过了检查。'+
        '<b>Sent</b> - 应用程序无法足够快地接受连接，因此内核无法在队列中存储此连接的条目。它没有丢弃它，而是向客户端发送了一个 SYN cookie。'+
        '<b>Failed</b> - 从 SYN cookie 解码的 MSS 无效。当此计数器递增时，'+
        '接收到的数据包将不会被视为 SYN cookie。</p>'
    },

    'ip.tcpmemorypressures': {
        info: '由于非致命的内存分配失败而使套接字处于内存压力状态的次数'+
        '（内核尝试通过减少发送缓冲区等来解决这种情况）。'
    },

    'ip.tcpconnaborts': {
        info: '<p>TCP 连接中止。</p>'+
        '<p><b>BadData</b> - 当连接处于 FIN_WAIT1 状态且内核接收到序列号超出此连接最后一个序列号的数据包时发生 - '+
        '内核响应 RST（关闭连接）。'+
        '<b>UserClosed</b> - 当内核在已关闭的连接上接收数据并响应 RST 时发生。'+
        '<b>NoMemory</b> - 当孤立套接字（未附加到 fd）过多且'+
        '内核必须丢弃连接时发生 - 有时它会发送 RST，有时不会。'+
        '<b>Timeout</b> - 当连接超时时发生。'+
        '<b>Linger</b> - 当内核杀死一个已被应用程序关闭且'+
        '逗留足够长时间的套接字时发生。'+
        '<b>Failed</b> - 当内核尝试发送 RST 但因没有可用内存而失败时发生。</p>'
    },

    'ip.tcp_syn_queue': {
        info: '<p>内核的 SYN 队列跟踪 TCP 握手，直到连接完全建立。' +
            '当太多传入的 TCP 连接请求挂起在半开状态且服务器' +
            '未配置为回退到 SYN cookies 时，它会溢出。溢出通常由 SYN 洪水 DoS 攻击引起。</p>' +
            '<p><b>Drops</b> - 因 SYN 队列已满且 SYN cookies 被禁用而丢弃的连接数。' +
            '<b>Cookies</b> - 因 SYN 队列已满而发送的 SYN cookies 数。</p>'
    },

    'ip.tcp_accept_queue': {
        info: '<p>内核的接受队列保存完全建立的 TCP 连接，等待' +
            '由监听应用程序处理。</p>'+
            '<b>Overflows</b> - 因'+
            '监听应用程序的接收队列已满而无法处理的已建立连接数。'+
            '<b>Drops</b> - 无法处理的传入连接数，包括 SYN 洪水、'+
            '溢出、内存不足、安全问题、无到达目的地的路由、接收相关 ICMP 消息、'+
            '套接字是广播或组播。</p>'
    },


    // ------------------------------------------------------------------------
    // IPv4

    'ipv4.packets': {
        info: '<p>此主机的 IPv4 数据包统计信息。</p>'+
        '<p><b>Received</b> - IP 层接收的数据包。'+
        '即使数据包稍后被丢弃，此计数器也会增加。'+
        '<b>Sent</b> - 通过 IP 层发送的数据包，包括单播和组播数据包。'+
        '此计数器不包括在 <b>Forwarded</b> 中计数的任何数据包。'+
        '<b>Forwarded</b> - 此主机不是其最终 IP 目的地的输入数据包，'+
        '因此尝试找到一条路由将它们转发到该最终目的地。'+
        '在不充当 IP 网关的主机中，此计数器将仅包括那些'+
        '<a href="https://en.wikipedia.org/wiki/Source_routing" target="_blank">源路由</a>'+
        '且源路由选项处理成功的数据包。'+
        '<b>Delivered</b> - 传递给上层协议的数据包，例如 TCP、UDP、ICMP 等。</p>'
    },

    'ipv4.fragsout': {
        info: '<p>此系统的 <a href="https://en.wikipedia.org/wiki/IPv4#Fragmentation" target="_blank">IPv4 分片</a>'+
        '统计信息。</p>'+
        '<p><b>OK</b> - 已成功分片的数据包。'+
        '<b>Failed</b> - 已被丢弃的数据包，因为它们需要分片'+
        '但无法分片，例如由于设置了<i>不分片</i> (DF) 标志。'+
        '<b>Created</b> - 作为分片结果生成的片段。</p>'
    },

    'ipv4.fragsin': {
        info: '<p>此系统的 <a href="https://en.wikipedia.org/wiki/IPv4#Reassembly" target="_blank">IPv4 重组</a>'+
        '统计信息。</p>'+
        '<p><b>OK</b> - 已成功重组的数据包。'+
        '<b>Failed</b> - IP 重组算法检测到的失败。'+
        '这不一定是丢弃的 IP 片段的计数，因为某些算法'+
        '可能在接收时通过组合片段而失去对片段数量的跟踪。'+
        '<b>All</b> - 需要重组的接收到的 IP 片段。</p>'
    },

    'ipv4.errors': {
        info: '<p>丢弃的 IPv4 数据包数。</p>'+
        '<p><b>InDiscards</b>、<b>OutDiscards</b> - 入站和出站数据包，即使没有检测到错误'+
        '也被选择丢弃，以防止它们被传递到更高层协议。'+
        '<b>InHdrErrors</b> - 由于 IP 头中的错误而被丢弃的输入数据包，包括'+
        '错误的校验和、版本号不匹配、其他格式错误、生存时间超出、'+
        '在处理其 IP 选项时发现的错误等。'+
        '<b>OutNoRoutes</b> - 因找不到路由'+
        '将它们传输到目的地而被丢弃的数据包。这包括主机无法路由的任何数据包，'+
        '因为其所有默认网关都已关闭。'+
        '<b>InAddrErrors</b> - 由于无效的 IP 地址或'+
        '目标 IP 地址不是本地地址且未启用 IP 转发而被丢弃的输入数据包。'+
        '<b>InUnknownProtos</b> - 因未知或不支持的协议而被丢弃的输入数据包。</p>'
    },

    'ipv4.icmp': {
        info: '<p>传输的 IPv4 ICMP 消息数。</p>'+
        '<p><b>Received</b>、<b>Sent</b> - 主机接收和尝试发送的 ICMP 消息。'+
        '这两个计数器都包括错误。</p>'
    },

    'ipv4.icmp_errors': {
        info: '<p>IPv4 ICMP 错误数。</p>'+
        '<p><b>InErrors</b> - 接收到的 ICMP 消息但被确定具有 ICMP 特定错误，'+
        '例如错误的 ICMP 校验和、错误的长度等。'+
        '<b>OutErrors</b> - 由于'+
        '在 ICMP 内发现的问题（如缓冲区不足）而此主机未发送的 ICMP 消息。'+
        '此计数器不包括在 ICMP 层之外发现的错误，'+
        '例如 IP 无法路由结果数据报。'+
        '<b>InCsumErrors</b> - 接收到的具有错误校验和的 ICMP 消息。</p>'
    },

    'ipv4.icmpmsg': {
        info: '传输的'+
        '<a href="https://www.iana.org/assignments/icmp-parameters/icmp-parameters.xhtml" target="_blank">IPv4 ICMP 控制消息</a>数。'
    },

    'ipv4.udppackets': {
        info: '传输的 UDP 数据包数。'
    },

    'ipv4.udperrors': {
        info: '<p>传输 UDP 数据包期间遇到的错误数。</p>'+
        '<b>RcvbufErrors</b> - 接收缓冲区已满。'+
        '<b>SndbufErrors</b> - 发送缓冲区已满、没有可用的内核内存，或'+
        'IP 层在尝试发送数据包时报告错误且未设置错误队列。'+
        '<b>InErrors</b> - 这是所有错误的聚合计数器，不包括 <b>NoPorts</b>。'+
        '<b>NoPorts</b> - 没有应用程序在目标端口监听。'+
        '<b>InCsumErrors</b> - 检测到 UDP 校验和失败。'+
        '<b>IgnoredMulti</b> - 忽略的组播数据包。'
    },

    'ipv4.udplite': {
        info: '传输的 UDP-Lite 数据包数。'
    },

    'ipv4.udplite_errors': {
        info: '<p>传输 UDP-Lite 数据包期间遇到的错误数。</p>'+
        '<b>RcvbufErrors</b> - 接收缓冲区已满。'+
        '<b>SndbufErrors</b> - 发送缓冲区已满、没有可用的内核内存，或'+
        'IP 层在尝试发送数据包时报告错误且未设置错误队列。'+
        '<b>InErrors</b> - 这是所有错误的聚合计数器，不包括 <b>NoPorts</b>。'+
        '<b>NoPorts</b> - 没有应用程序在目标端口监听。'+
        '<b>InCsumErrors</b> - 检测到 UDP 校验和失败。'+
        '<b>IgnoredMulti</b> - 忽略的组播数据包。'
    },

    'ipv4.tcppackets': {
        info: '<p>TCP 层传输的数据包数。</p>'+
        '</p><b>Received</b> - 接收到的数据包，包括接收时出错的数据包，'+
        '例如校验和错误、无效的 TCP 头等。'+
        '<b>Sent</b> - 发送的数据包，不包括重传的数据包。'+
        '但它包括 SYN、ACK 和 RST 数据包。</p>'
    },

    'ipv4.tcpsock': {
        info: '当前状态为 ESTABLISHED 或 CLOSE-WAIT 的 TCP 连接数。'+
        '这是测量时已建立连接的快照'+
        '（即在同一迭代内建立的连接和断开的连接不会影响此指标）。'
    },

    'ipv4.tcpopens': {
        info: '<p>TCP 连接统计信息。</p>'+
        '<p><b>Active</b> - 此主机尝试的出站 TCP 连接数。'+
         '<b>Passive</b> - 此主机接受的入站 TCP 连接数。</p>'
    },

    'ipv4.tcperrors': {
        info: '<p>TCP 错误。</p>'+
        '<p><b>InErrs</b> - 接收时出错的 TCP 段'+
        '（包括头太小、校验和错误、序列错误、错误数据包 - 适用于 IPv4 和 IPv6）。'+
        '<b>InCsumErrors</b> - 接收到具有校验和错误的 TCP 段（适用于 IPv4 和 IPv6）。'+
        '<b>RetransSegs</b> - 重传的 TCP 段。</p>'
    },

    'ipv4.tcphandshake': {
        info: '<p>TCP 握手统计信息。</p>'+
        '<p><b>EstabResets</b> - 已建立连接的重置'+
        '（即从 ESTABLISHED 或 CLOSE_WAIT 直接转换到 CLOSED 的连接）。'+
        '<b>OutRsts</b> - 发送的带有 RST 标志的 TCP 段（适用于 IPv4 和 IPv6）。'+
        '<b>AttemptFails</b> - TCP 连接从'+
        'SYN_SENT 或 SYN_RECV 直接转换到 CLOSED 的次数，加上 TCP 连接从'+
        'SYN_RECV 直接转换到 LISTEN 的次数。'+
        '<b>SynRetrans</b> - 显示新出站 TCP 连接的重试次数，'+
        '这可能表示一般连接问题或远程主机上的积压。</p>'
    },

    'ipv4.sockstat_sockets': {
        info: '此系统中所有'+
        '<a href="https://man7.org/linux/man-pages/man7/address_families.7.html" target="_blank">地址族</a>'+
        '使用的套接字总数。'
    },

    'ipv4.sockstat_tcp_sockets': {
        info: '<p>系统中处于特定'+
        '<a href="https://en.wikipedia.org/wiki/Transmission_Control_Protocol#Protocol_operation" target="_blank">状态</a>的 TCP 套接字数。</p>'+
        '<p><b>Alloc</b> - 处于任何 TCP 状态。'+
        '<b>Orphan</b> - 不再附加到任何用户进程中的套接字描述符，'+
        '但内核仍需要维护状态以完成传输协议。'+
        '<b>InUse</b> - 处于任何 TCP 状态，不包括 TIME-WAIT 和 CLOSED。'+
        '<b>TimeWait</b> - 处于 TIME-WAIT 状态。</p>'
    },

    'ipv4.sockstat_tcp_mem': {
        info: '已分配的 TCP 套接字使用的内存量。'
    },

    'ipv4.sockstat_udp_sockets': {
        info: '使用的 UDP 套接字数。'
    },

    'ipv4.sockstat_udp_mem': {
        info: '已分配的 UDP 套接字使用的内存量。'
    },

    'ipv4.sockstat_udplite_sockets': {
        info: '使用的 UDP-Lite 套接字数。'
    },

    'ipv4.sockstat_raw_sockets': {
        info: '使用的<a href="https://en.wikipedia.org/wiki/Network_socket#Types" target="_blank">原始套接字</a>数。'
    },

    'ipv4.sockstat_frag_sockets': {
        info: '用于数据包重组的哈希表中的条目数。'
