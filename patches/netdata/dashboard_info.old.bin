    'disk_ext.iotime': {
        height: 0.5,
        info: '所有已完成丢弃/刷新操作的持续时间总和。如果磁盘能够并行执行丢弃/刷新操作，此数字可以超过间隔。'
    },
    'disk.mops': {
        height: 0.5,
        info: '合并的磁盘操作数。系统能够合并相邻的 I/O 操作，例如，两个 4KB 读取可以在交给磁盘之前变成一个 8KB 读取。'
    },
    'disk_ext.mops': {
