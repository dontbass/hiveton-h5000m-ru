    },

    'zfs.hash_elements': {
        info: '<p>数据虚拟地址 (DVA) 哈希表元素统计信息。</p>'+
        '<p><b>Current</b> - 当前元素数。 '+
        '<b>Max</b> - 看到的最大元素数。</p>'
    },

    'zfs.hash_chains': {
        info: '<p>数据虚拟地址 (DVA) 哈希表链统计信息。 '+
        '当两个或多个不同的数据块编号具有相同的哈希值时形成链。</p>'+
        '<p><b>Current</b> - 当前链数。 '+
        '<b>Max</b> - 看到的最长链长度。 '+
        '如果该值较高，则在遍历链时哈希锁会保持更长时间，性能可能会下降。</p>'
    },

    // ------------------------------------------------------------------------
    // ZFS pools
    'zfspool.state': {
        info: 'ZFS 池状态。 '+
        '池的整体健康状况（由 <code>zpool status</code> 报告）'+
        '由池中所有设备的聚合状态决定。 ' +
        '有关状态说明，'+
        '请参阅 <a href="https://openzfs.github.io/openzfs-docs/man/7/zpoolconcepts.7.html#Device_Failure_and_Recovery" target="_blank"> ZFS 文档</a>。'
    },

    // ------------------------------------------------------------------------
    // MYSQL

    'mysql.net': {
        info: '发送到 mysql 客户端（<strong>out</strong>）和从 mysql 客户端接收（<strong>in</strong>）的数据量。'
    },

    'mysql.queries': {
        info: '服务器执行的语句数。<ul>' +
            '<li><strong>queries</strong> 统计存储的 SQL 程序中执行的语句数。</li>' +
            '<li><strong>questions</strong> 统计 mysql 客户端发送到 mysql 服务器的语句数。</li>' +
            '<li><strong>slow queries</strong> 统计执行时间超过 <a href="http://dev.mysql.com/doc/refman/5.7/en/server-system-variables.html#sysvar_long_query_time" target="_blank">long_query_time</a> 秒的语句数。' +
            ' 有关慢查询的更多信息，请查看 mysql <a href="http://dev.mysql.com/doc/refman/5.7/en/slow-query-log.html" target="_blank">慢查询日志</a>。</li>' +
            '</ul>'
    },

    'mysql.handlers': {
        info: 'mysql 内部处理程序的使用情况。该图表提供了 mysql 服务器实际操作的很好见解。' +
            '（如果图表未显示所有这些维度，是因为它们为零 - 从仪表板设置中将<strong>要显示哪些维度？</strong>设置为<strong>全部</strong>，以呈现包括零值在内的所有值）<ul>' +
            '<li><strong>commit</strong>，内部 <a href="http://dev.mysql.com/doc/refman/5.7/en/commit.html" target="_blank">COMMIT</a> 语句数。</li>' +
            '<li><strong>delete</strong>，从表中删除行的次数。</li>' +
            '<li><strong>prepare</strong>，两阶段提交操作准备阶段的计数器。</li>' +
            '<li><strong>read first</strong>，读取索引中第一个条目的次数。高值表明服务器正在进行大量全索引扫描；例如 <strong>SELECT col1 FROM foo</strong>，其中 col1 已建立索引。</li>' +
            '<li><strong>read key</strong>，基于键读取行的请求数。如果此值很高，这很好地表明您的表已针对查询进行了适当的索引。</li>' +
            '<li><strong>read next</strong>，按键顺序读取下一行的请求数。如果您正在使用范围约束查询索引列或正在执行索引扫描，则会增加此值。</li>' +
            '<li><strong>read prev</strong>，按键顺序读取前一行的请求数。此读取方法主要用于优化 <strong>ORDER BY ... DESC</strong>。</li>' +
            '<li><strong>read rnd</strong>，基于固定位置读取行的请求数。高值表明您正在执行大量需要对结果进行排序的查询。您可能有很多需要 MySQL 扫描整个表的查询，或者您的联接未正确使用键。</li>' +
            '<li><strong>read rnd next</strong>，读取数据文件中下一行的请求数。如果您正在执行大量表扫描，则此值会很高。通常这表明您的表未正确建立索引，或者您的查询未编写为利用现有索引。</li>' +
            '<li><strong>rollback</strong>，存储引擎执行回滚操作的请求数。</li>' +
            '<li><strong>savepoint</strong>，存储引擎放置保存点的请求数。</li>' +
            '<li><strong>savepoint rollback</strong>，存储引擎回滚到保存点的请求数。</li>' +
            '<li><strong>update</strong>，更新表中某行的请求数。</li>' +
            '<li><strong>write</strong>，在表中插入行的请求数。</li>' +
            '</ul>'
    },

    'mysql.table_locks': {
        info: 'MySQL 表锁计数器：<ul>' +
            '<li><strong>immediate</strong>，可以立即授予表锁请求的次数。</li>' +
            '<li><strong>waited</strong>，无法立即授予表锁请求并需要等待的次数。如果此值很高且您遇到性能问题，应首先优化查询，然后拆分表或使用复制。</li>' +
            '</ul>'
    },

    'mysql.innodb_deadlocks': {
        info: '当两个或多个事务相互持有并请求锁时，会发生死锁，从而形成依赖循环。有关<a href="https://dev.mysql.com/doc/refman/5.7/en/innodb-deadlocks-handling.html" target="_blank">如何最小化和处理死锁</a>的更多信息。'
    },

    'mysql.galera_cluster_status': {
        info: "<p>此集群组件的状态。</p><p><b>Primary</b> - 主组配置，存在仲裁。<b>Non-Primary</b> - 非主组配置，失去仲裁。<b>Disconnected</b> - 未连接到组，正在重试。</p>"
    },

    'mysql.galera_cluster_state': {
        info: "<p>此集群组件的成员状态。</p><p><b>Undefined</b> - 未定义状态。<b>Joining</b> - 节点正在尝试加入集群。<b>Donor</b> - 节点在发送状态快照传输 (SST) 以使新节点与集群保持最新状态时已阻塞自身。<b>Joined</b> - 节点已成功加入集群。<b>Synced</b> - 节点已与集群建立连接并已将其本地数据库与集群数据库同步。<b>Error</b> - 节点不是集群的一部分且不复制事务。此状态特定于提供程序，请查看 <i>wsrep_local_state_comment</i> 变量以获取说明。</p>"
    },

    'mysql.galera_cluster_weight': {
        info: '该值计算为当前主组件中节点的 <code>pc.weight</code> 之和。'
    },

    'mysql.galera_connected': {
        info: '<code>0</code> 表示该节点尚未连接到任何集群组件。 ' +
            '这可能是由于配置错误所致。'
    },

    'mysql.open_transactions': {
        info: '在 wsrep 提供程序内注册的本地运行事务数。 ' +
            '这意味着已执行导致写入集填充的操作的事务。 ' +
            '只读事务不计入其中。'
    },


    // ------------------------------------------------------------------------
    // POSTGRESQL
    'postgres.connections_utilization': {
        room: { 
            mainheads: [
                function (_, id) {
                    return '<div data-netdata="' + id + '"'
                        + ' data-append-options="percentage"'
                        + ' data-gauge-max-value="100"'
                        + ' data-chart-library="gauge"'
                        + ' data-title="Connections Utilization"'
                        + ' data-units="%"'
                        + ' data-gauge-adjust="width"'
                        + ' data-width="12%"'
                        + ' data-before="0"'
                        + ' data-after="-CHART_DURATION"'
                        + ' data-points="CHART_DURATION"'
                        + ' data-colors="' + NETDATA.colors[1] + '"'
                        + ' role="application"></div>';
                }
            ],
        },
        info: '<b>所有数据库的总连接利用率</b>。利用率以 (<i>max_connections</i> - <i>superuser_reserved_connections</i>) 的百分比来衡量。如果利用率为 100%，将不再接受新连接（如果超级用户配额可用，仍将接受超级用户连接）。'
    },
    'postgres.connections_usage': {
        info: '<p><b>所有数据库的连接使用情况</b>。数据库服务器的最大并发连接数为 (<i>max_connections</i> - <i>superuser_reserved_connections</i>)。一般来说，如果您需要超过 200 个连接，建议使用连接池。</p><p><b>Available</b> - 允许的新连接数。<b>Used</b> - 当前使用的连接数。</p>'
    },
    'postgres.connections_state_count': {
        info: '<p>所有数据库中每种状态的连接数。</p><p><b>Active</b> - 后端正在执行查询。<b>Idle</b> - 后端正在等待新的客户端命令。<b>IdleInTransaction</b> - 后端处于事务中，但当前未执行查询。<b>IdleInTransactionAborted</b> - 后端处于事务中，且当前未执行查询，但事务中的某个语句导致了错误。<b>FastPathFunctionCall</b> - 后端正在执行快速路径函数。<b>Disabled</b> - 如果此后端中禁用了 <a href="https://www.postgresql.org/docs/current/runtime-config-statistics.html#GUC-TRACK-ACTIVITIES" target="_blank"><i>track_activities</i></a>，则会报告此状态。</p>'
    },
    'postgres.transactions_duration': {
        info: '正在运行的事务持续时间直方图。箱子被指定为连续的、非重叠的间隔。该值是落入每个间隔的观察到的事务数。'
    },
    'postgres.queries_duration': {
        info: '活动查询持续时间直方图。箱子被指定为连续的、非重叠的间隔。该值是落入每个间隔的观察到的活动查询数。'
    },
    'postgres.checkpoints_rate': {
        info: '<p>已执行的检查点数。检查点是数据库执行的定期维护操作，以确保其在内存中缓存的所有内容都已与磁盘同步。理想情况下，检查点应该是时间驱动的（计划的），而不是负载驱动的（请求的）。</p><p><b>Scheduled</b> - 当距离上一个检查点的时间大于 <a href="https://www.postgresql.org/docs/current/runtime-config-wal.html#GUC-CHECKPOINT-TIMEOUT" target="_blank"><i>checkpoint_timeout</i></a> 时，按计划触发的检查点。<b>Requested</b> - 由于 WAL 更新在达到 <i>checkpoint_timeout</i> 之前达到 <a href="https://www.postgresql.org/docs/current/runtime-config-wal.html#GUC-MAX-WAL-SIZE" target="_blank"><i>max_wal_size</i></a> 而触发的检查点。</p>'
    },
    'postgres.checkpoints_time': {
        info: '<p>检查点计时信息。检查点 I/O 性能的一个重要指标是将文件同步到磁盘所花费的时间。</p><p><b>Write</b> - 在检查点处理期间将文件写入磁盘所花费的时间。<b>Sync</b> - 在检查点处理期间将文件同步到磁盘所花费的时间。</p>'
    },
    'postgres.buffers_allocated_rate': {
        info: '已分配和重新分配的缓冲区。如果后端进程请求数据，要么在共享缓冲区缓存的块中找到它，要么必须分配该块（从磁盘读取）。后者计为 <b>Allocated</b>。'
    },
    'postgres.buffers_io_rate': {
        info: '<p>从内存刷新到磁盘的数据量。</p><p><b>Checkpoint</b> - 在检查点期间写入的缓冲区。<b>Backend</b> - 由后端直接写入的缓冲区。后端进程可能会请求脏页。在这种情况下，页面会在返回给客户端之前同步到磁盘。<b>BgWriter</b> - 由后台写入器写入的缓冲区。PostgreSQL 可能会提前清除使用计数较低的页面。该进程扫描使用计数较低的脏页，以便在必要时可以清除它们。此进程写入的缓冲区会增加计数器。</p>'
    },
    'postgres.bgwriter_halts_rate': {
        info: '后台写入器停止清理扫描的次数，因为它写入了太多缓冲区（超过了 <a href="https://www.postgresql.org/docs/current/runtime-config-resource.html#RUNTIME-CONFIG-RESOURCE-BACKGROUND-WRITER" target="_blank"><i>bgwriter_lru_maxpages</i></a> 的值）。'
    },
    'postgres.buffers_backend_fsync_rate': {
        info: '后端必须执行自己的 fsync 调用的次数（通常即使后端执行自己的写入，后台写入器也会处理这些调用）。任何大于零的值都可能表明当 fsync 队列完全填满时存储存在问题。'
    },
    'postgres.wal_io_rate': {
        info: '预写日志 (WAL) 通过确保只有在描述更改的日志记录已刷新到永久存储之后才写入数据文件（表和索引所在的位置）的更改，来确保数据完整性。'
    },
    'postgres.wal_files_count': {
        info: '<p>存储在数据目录下的 <i>pg_wal</i> 目录中的 WAL 日志数。</p><p><b>Written</b> - 生成的日志段文件。<b>Recycled</b> - 不再需要的旧日志段文件。重命名为编号序列中的未来段，以避免需要创建新段。</p>'
    },
    'postgres.wal_archiving_files_count': {
        info: '<p>WAL 归档。</p><p><b>Ready</b> - 等待归档的 WAL 文件。非零值可能表明 <i>archive_command</i> 存在错误，请参阅<a href="https://www.postgresql.org/docs/current/static/continuous-archiving.html" target="_blank">连续归档和时间点恢复</a>。<b>Done</b> - 成功归档的 WAL 文件。'
    },
    'postgres.autovacuum_workers_count': {
        info: 'PostgreSQL 数据库需要定期维护，称为清理。对于许多安装，让 autovacuum 守护进程执行清理就足够了。有关更多信息，请参阅 <a href="https://www.postgresql.org/docs/current/static/routine-vacuuming.html#AUTOVACUUM" target="_blank">Autovacuum 守护进程</a>。'
    },
    'postgres.txid_exhaustion_towards_autovacuum_perc': {
        info: '一个或多个表的紧急自动清理百分比。一旦此值达到 100%，将运行强制自动清理。有关更多信息，请参阅<a href="https://www.postgresql.org/docs/current/routine-vacuuming.html#VACUUM-FOR-WRAPAROUND" target="_blank">防止事务 ID 回绕失败</a>。'
    },
    'postgres.txid_exhaustion_perc': {
        info: '事务回绕百分比。当此值达到 100% 时，可能会发生事务回绕。有关更多信息，请参阅<a href="https://www.postgresql.org/docs/current/routine-vacuuming.html#VACUUM-FOR-WRAPAROUND" target="_blank">防止事务 ID 回绕失败</a>。'
    },
    'postgres.txid_exhaustion_oldest_txid_num': {
        info: '最旧的当前事务 ID (XID)。如果由于某种原因，autovacuum 未能从表中清除旧的 XID，当数据库最旧的 XID 距离回绕点达到 1100 万个事务时，系统将开始发出警告消息。有关更多信息，请参阅<a href="https://www.postgresql.org/docs/current/routine-vacuuming.html#VACUUM-FOR-WRAPAROUND" target="_blank">防止事务 ID 回绕失败</a>。'
    },
    'postgres.uptime': {
        room: { 
            mainheads: [
                function (os, id) {
                    void (os);
                    return '<div data-netdata="' + id + '"'
                        + ' data-chart-library="easypiechart"'
                        + ' data-title="Uptime"'
                        + ' data-units="Seconds"'
                        + ' data-gauge-adjust="width"'
                        + ' data-width="10%"'
                        + ' data-before="0"'
                        + ' data-after="-CHART_DURATION"'
                        + ' data-points="CHART_DURATION"'
                        + ' role="application"></div>';
                }
            ],
        },
        info: '自 Postgres 进程启动以来经过的时间。'
    },

    'postgres.replication_app_wal_lag_size': {
        info: '<p>复制 WAL 滞后大小。</p><p><b>SentLag</b> - 通过网络发送。<b>WriteLag</b> - 写入磁盘。<b>FlushLag</b> - 刷新到磁盘。<b>ReplayLag</b> - 重放到数据库。</p>'
    },
    'postgres.replication_app_wal_lag_time': {
        info: '<p>复制 WAL 滞后时间。</p><p><b>WriteLag</b> - 本地刷新最近的 WAL 与接收到备用服务器已写入但尚未刷新或应用的通知之间经过的时间。<b>FlushLag</b> - 本地刷新最近的 WAL 与接收到备用服务器已写入和刷新但尚未应用的通知之间经过的时间。<b>ReplayLag</b> - 本地刷新最近的 WAL 与接收到备用服务器已写入、刷新和应用的通知之间经过的时间。</p>'
    },
    'postgres.replication_slot_files_count': {
        info: '<p>复制插槽文件。有关更多信息，请参阅<a href="https://www.postgresql.org/docs/current/static/warm-standby.html#STREAMING-REPLICATION-SLOTS" target="_blank">复制插槽</a>。</p><p><b>WalKeep</b> - 复制插槽保留的 WAL 文件。<b>PgReplslotFiles</b> - pg_replslot 中存在的文件。</p>'
    },

    'postgres.db_transactions_ratio': {
        info: '已提交/回滚事务的百分比。'
    },
    'postgres.db_transactions_rate': {
        info: '<p>已执行的事务数</p><p><b>Committed</b> - 已提交的事务。已提交事务所做的所有更改对其他事务可见，并且在发生崩溃时保证是持久的。<b>Rollback</b> - 已回滚的事务。回滚会中止当前事务，并导致事务所做的所有更新被丢弃。事务之外失败的单个查询也计为回滚。</p>'
    },
    'postgres.db_connections_utilization': {
        info: '每个数据库的连接利用率。利用率以每个数据库的 <i>CONNECTION LIMIT</i>（如果已设置）或 <i>max_connections</i>（如果未设置 <i>CONNECTION LIMIT</i>）的百分比来衡量。'
    },
    'postgres.db_connections_count': {
        info: '每个数据库的当前连接数。'
    },    
    'postgres.db_cache_io_ratio': {
        room: { 
            mainheads: [
                function (_, id) {
                    return '<div data-netdata="' + id + '"'
                        + ' data-append-options="percentage"'
                        + ' data-gauge-max-value="100"'
                        + ' data-chart-library="gauge"'
                        + ' data-title="Cache Miss Ratio"'
                        + ' data-units="%"'
                        + ' data-gauge-adjust="width"'
                        + ' data-width="12%"'
                        + ' data-before="0"'
                        + ' data-after="-CHART_DURATION"'
                        + ' data-points="CHART_DURATION"'
                        + ' data-colors="' + NETDATA.colors[1] + '"'
                        + ' role="application"></div>';
                }
            ],
        },
        info: 'PostgreSQL 使用<b>共享缓冲区缓存</b>将频繁访问的数据存储在内存中，避免较慢的磁盘读取。如果您遇到性能问题，请考虑增加 <a href="https://www.postgresql.org/docs/current/runtime-config-resource.html#GUC-SHARED-BUFFERS" target="_blank"><i>shared_buffers</i></a> 大小或调整 <a href="https://www.postgresql.org/docs/current/runtime-config-query.html#GUC-EFFECTIVE-CACHE-SIZE" target="_blank"><i>effective_cache_size</i></a>。'
    },
    'postgres.db_io_rate': {
        info: '<p>从共享缓冲区缓存或磁盘读取的数据量。</p><p><b>Disk</b> - 从磁盘读取的数据。<b>Memory</b> - 从缓冲区缓存读取的数据（这仅包括 PostgreSQL 缓冲区缓存中的命中，不包括操作系统的文件系统缓存）。</p>'
    },
    'postgres.db_ops_fetched_rows_ratio': {
        room: {
            mainheads: [
                function (_, id) {
                    return '<div data-netdata="' + id + '"'
                        + ' data-append-options="percentage"'
                        + ' data-gauge-max-value="100"'
                        + ' data-chart-library="gauge"'
                        + ' data-title="Rows Fetched vs Returned"'
                        + ' data-units="%"'
                        + ' data-gauge-adjust="width"'
                        + ' data-width="12%"'
                        + ' data-before="0"'
                        + ' data-after="-CHART_DURATION"'
                        + ' data-points="CHART_DURATION"'
                        + ' data-colors="' + NETDATA.colors[1] + '"'
                        + ' role="application"></div>';
                }
            ],
        }, 
        info: '包含执行查询所需数据的行在扫描的总行数中所占的百分比。高值表明数据库正在高效地执行查询，而低值表明数据库通过扫描大量不需要处理查询的行而执行额外的工作。低值可能是由于缺少索引或查询效率低下造成的。'
    },
    'postgres.db_ops_read_rows_rate': {
        info: '<p>读取查询吞吐量。</p><p><b>Returned</b> - 查询扫描的总行数。此值表示存储层返回以供扫描的行，而不是返回给客户端的行。<b>Fetched</b> - 包含执行查询所需数据的已扫描行（<b>Returned</b>）的子集。</p>'
    },
    'postgres.db_ops_write_rows_rate': {
        info: '<p>写入查询吞吐量。</p><p><b>Inserted</b> - 查询插入的行数。<b>Deleted</b> - 查询删除的行数。<b>Updated</b> - 查询更新的行数。</p>'
    },
    'postgres.db_conflicts_rate': {
        info: '由于与备用服务器上的恢复冲突而取消的查询数。要最小化由清理记录引起的查询取消，请考虑配置 <a href="https://www.postgresql.org/docs/current/runtime-config-replication.html#GUC-HOT-STANDBY-FEEDBACK" target="_blank"><i>hot_standby_feedback</i></a>。'
    },
    'postgres.db_conflicts_reason_rate': {
        info: '<p>由于备用服务器上各种类型的冲突而取消的查询统计信息。</p><p><b>Tablespace</b> - 由于表空间被删除而取消的查询。<b>Lock</b> - 由于锁超时而取消的查询。<b>Snapshot</b> - 由于旧快照而取消的查询。<b>Bufferpin</b> - 由于固定缓冲区而取消的查询。<b>Deadlock</b> - 由于死锁而取消的查询。</p>'
    },
    'postgres.db_deadlocks_rate': {
        info: '检测到的死锁数。当事务无法在一定时间内（由 <b>deadlock_timeout</b> 配置）获取请求的锁时，它将开始死锁检测。'
    },
    'postgres.db_locks_held_count': {
        info: '持有的锁数。PostgreSQL 在语句执行之前会自动获取其中一些锁模式，而其他锁模式则提供给应用程序使用。事务中获取的所有锁模式在事务期间都会保持。有关锁模式的详细信息，请参阅<a href="https://www.postgresql.org/docs/current/explicit-locking.html#LOCKING-TABLES" target="_blank">表级锁</a>。'
    },
    'postgres.db_locks_awaited_count': {
        info: '等待的锁数。它表明某些事务当前正在等待获取锁，这意味着其他事务在同一可锁定对象上持有冲突的锁模式。有关锁模式的详细信息，请参阅<a href="https://www.postgresql.org/docs/current/explicit-locking.html#LOCKING-TABLES" target="_blank">表级锁</a>。'
    },
    'postgres.db_temp_files_created_rate': {
        info: '查询创建的临时文件数。复杂查询可能需要比可用内存（由 <b>work_mem</b> 指定）更多的内存。发生这种情况时，Postgres 会恢复使用临时文件 - 它们实际上存储在磁盘上，但仅在请求期间存在。请求返回后，临时文件将被删除。'
    },
    'postgres.db_temp_files_io_rate': {
        info: '为执行查询临时写入磁盘的数据量。'
    },
    'postgres.db_size': {
        room: {
            mainheads: [
                function (os, id) {
                    void (os);
                    return '<div data-netdata="' + id + '"'
                        + ' data-chart-library="easypiechart"'
                        + ' data-title="DB Size"'
                        + ' data-units="MiB"'
                        + ' data-gauge-adjust="width"'
                        + ' data-width="10%"'
                        + ' data-before="0"'
                        + ' data-after="-CHART_DURATION"'
                        + ' data-points="CHART_DURATION"'
                        + ' role="application"></div>';
                }
            ],
        },        
        info: '数据库数据目录和任何关联表空间的实际磁盘使用量。'
    },
    'postgres.table_rows_dead_ratio': {
        info: '死行百分比。死行增加表明 VACUUM 进程存在问题，这可能会减慢查询速度。'
    },
    'postgres.table_rows_count': {
        info: '<p>行数。当您执行 UPDATE 或 DELETE 时，该行实际上并未物理删除。对于 DELETE，数据库只是将该行标记为对未来事务不可用，对于 UPDATE，在底层它是一个组合的 INSERT 然后 DELETE，其中该行的前一个版本标记为不可用。</p><p><b>Live</b> - 当前正在使用且可以查询的行。<b>Dead</b> - 已删除的行，稍后将重新用于来自 INSERT 或 UPDATE 的新行。</p>'
    },
    'postgres.table_ops_rows_rate': {
        info: '写入查询吞吐量。如果您看到大量更新和删除的行，请密切关注死行数，因为高百分比的死行可能会减慢查询速度。'
    },
    'postgres.table_ops_rows_hot_ratio': {
        info: 'HOT（仅堆元组）更新行的百分比。HOT 更新比普通更新效率高得多：更少的写入操作、更少的 WAL 写入、vacuum 操作要做的工作更少、提高了读取效率（有助于限制表和索引膨胀）。'
    },
    'postgres.table_ops_rows_hot_rate': {
        info: 'HOT（仅堆元组）更新的行数。'
    },
    'postgres.table_cache_io_ratio': {
        info: '表缓存效率低下。从磁盘读取的数据百分比。越低越好。'
    },
    'postgres.table_io_rate': {
        info: '<p>从共享缓冲区缓存或磁盘读取的数据量。</p><p><b>Disk</b> - 从磁盘读取的数据。<b>Memory</b> - 从缓冲区缓存读取的数据（这仅包括 PostgreSQL 缓冲区缓存中的命中，不包括操作系统的文件系统缓存）。</p>'
    },
    'postgres.table_index_cache_io_ratio': {
        info: '表索引缓存效率低下。从磁盘读取的数据百分比。越低越好。'
    },
    'postgres.table_index_io_rate': {
        info: '<p>从共享缓冲区缓存或磁盘读取所有索引的数据量。</p><p><b>Disk</b> - 从磁盘读取的数据。<b>Memory</b> - 从缓冲区缓存读取的数据（这仅包括 PostgreSQL 缓冲区缓存中的命中，不包括操作系统的文件系统缓存）。</p>'
    },
    'postgres.table_toast_cache_io_ratio': {
        info: '表 TOAST 缓存效率低下。从磁盘读取的数据百分比。越低越好。'
    },
    'postgres.table_toast_io_rate': {
        info: '<p>从共享缓冲区缓存或磁盘读取 TOAST 表的数据量。</p><p><b>Disk</b> - 从磁盘读取的数据。<b>Memory</b> - 从缓冲区缓存读取的数据（这仅包括 PostgreSQL 缓冲区缓存中的命中，不包括操作系统的文件系统缓存）。</p>'
    },
    'postgres.table_toast_index_cache_io_ratio': {
        info: '表 TOAST 索引缓存效率低下。从磁盘读取的数据百分比。越低越好。'
    },
    'postgres.table_toast_index_io_rate': {
        info: '<p>从共享缓冲区缓存或磁盘读取此表的 TOAST 表索引的数据量。</p><p><b>Disk</b> - 从磁盘读取的数据。<b>Memory</b> - 从缓冲区缓存读取的数据（这仅包括 PostgreSQL 缓冲区缓存中的命中，不包括操作系统的文件系统缓存）。</p>'
    },
    'postgres.table_scans_rate': {
        info: '<p>在此表上启动的扫描数。如果您发现数据库随着时间的推移定期执行更多顺序扫描，可以通过对频繁访问的数据创建索引来提高其性能。</p><p><b>Index</b> - 依靠索引指向特定行的位置。<b>Sequential</b> - 必须按顺序扫描表的每一行。通常比索引扫描花费的时间更长。</p>'
    },
    'postgres.table_scans_rows_rate': {
        info: '扫描获取的活动行数。'
    },
    'postgres.table_autovacuum_since_time': {
        info: '自此表被 autovacuum 守护进程清理以来经过的时间。'
    },
    'postgres.table_vacuum_since_time': {
        info: '自此表被手动清理以来经过的时间（不包括 VACUUM FULL）。'
    },
    'postgres.table_autoanalyze_since_time': {
        info: '自此表被 autovacuum 守护进程分析以来经过的时间。'
    },
    'postgres.table_analyze_since_time': {
        info: '自此表被手动分析以来经过的时间。'
    },
    'postgres.table_null_columns': {
        info: '仅包含 NULL 的表列数。'
    },
    'postgres.table_total_size': {
        info: '表的实际磁盘大小。'
    },
    'postgres.table_bloat_size_perc': {
        info: '表中膨胀的估计百分比。频繁更新的表有少量到中等程度的膨胀是正常的。'
    },
    'postgres.table_bloat_size': {
        info: '表曾经使用且可供数据库重用但尚未回收的磁盘空间。膨胀的表需要更多的磁盘存储和额外的 I/O，这可能会减慢查询执行速度。定期对频繁更新的表运行 <a href="https://www.postgresql.org/docs/current/sql-vacuum.html" target="_blank">VACUUM</a> 可以快速重用过期行占用的空间，从而防止表变得过大。'
    },
    'postgres.index_size': {
        info: '索引的实际磁盘大小。'
    },
    'postgres.index_bloat_size_perc': {
        info: '索引中膨胀的估计百分比。'
    },
    'postgres.index_bloat_size': {
        info: '索引曾经使用且可供数据库重用但尚未回收的磁盘空间。膨胀会降低数据库速度并占用超出所需的存储空间。要从索引回收空间，请使用 <a href="https://www.postgresql.org/docs/current/sql-reindex.html" target="_blank">REINDEX</a> 命令重新创建它们。'
    },
    'postgres.index_usage_status': {
        info: '如果未在该索引上启动任何扫描，则认为索引未使用。'
    },


    // ------------------------------------------------------------------------
    // PgBouncer
    'pgbouncer.client_connections_utilization': {
        info: '正在使用的客户端连接占 <i>max_client_conn</i>（默认为 100）的百分比。'
    },
    'pgbouncer.db_client_connections': {
        info: '<p>处于不同状态的客户端连接。</p><p><b>Active</b> - 链接到服务器连接并可以处理查询。<b>Waiting</b> - 已发送查询但尚未获得服务器连接。<b>CancelReq</b> - 尚未将查询取消转发到服务器。</p>'
    },
    'pgbouncer.db_server_connections': {
        info: '<p>处于不同状态的服务器连接。</p><p><b>Active</b> - 链接到客户端。<b>Idle</b> - 未使用且可立即用于客户端查询。<b>Used</b> - 空闲时间超过 <i>server_check_delay</i>，因此需要在再次使用之前运行 <i>server_check_query</i>。<b>Tested</b> - 当前正在运行 <i>server_reset_query</i> 或 <i>server_check_query</i>。<b>Login</b> - 当前正在登录过程中。</p>'
    },
    'pgbouncer.db_server_connections_utilization': {
        info: '正在使用的服务器连接占 <i>max_db_connections</i>（默认为 0 - 无限制）的百分比。这考虑的是客户端已连接到的 PgBouncer 数据库，而不是传出连接的 PostgreSQL 数据库。'
    },
    'pgbouncer.db_clients_wait_time': {
        info: '客户端等待服务器连接所花费的时间。这显示从客户端角度看数据库性能下降是否由于相应 PgBouncer 池耗尽所致。'
    },
    'pgbouncer.db_client_max_wait_time': {
        info: '队列中第一个（最旧）客户端的等待时间。如果此值开始增加，则当前服务器池无法足够快地处理请求。'
    },
    'pgbouncer.db_transactions': {
        info: 'pgbouncer 池化（代理）的 SQL 事务。'
    },
    'pgbouncer.db_transactions_time': {
        info: 'pgbouncer 连接到 PostgreSQL 处于事务中时所花费的时间，无论是事务中空闲还是执行查询。'
    },
    'pgbouncer.db_transaction_avg_time': {
        info: '平均事务持续时间。'
    },
    'pgbouncer.db_queries': {
        info: 'pgbouncer 池化（代理）的 SQL 查询。'
    },
    'pgbouncer.db_queries_time': {
        info: 'pgbouncer 主动连接到 PostgreSQL 并执行查询时所花费的时间。'
    },
    'pgbouncer.db_query_avg_time': {
        info: '平均查询持续时间。'
    },
    'pgbouncer.db_network_io': {
        info: '<p>pgbouncer 接收和发送的网络流量。</p><p><b>Received</b> - 从客户端接收。<b>Sent</b> - 发送到服务器。</p>'
    },

