    },
    'nginxplus.resolver_zone_responses_rate': {
        info: '<p>解析器区域 DNS 响应。</p><p><b>NoError</b> - 成功的响应。<b>FormErr</b> - 格式错误响应。<b>ServFail</b> - 服务器失败响应。<b>NXDomain</b> - 未找到主机响应。<b>NotImp</b> - 未实现响应。<b>Refused</b> - 操作拒绝响应。<b>TimedOut</b> - 超时请求。<b>Unknown</b> - 完成但出现未知错误的请求。</p>'
    },

    // ------------------------------------------------------------------------
    // HTTP check

    'httpcheck.responsetime': {
        info: '<code>响应时间</code>描述请求和响应之间经过的时间。 ' +
            '目前，响应时间的精度较低，应仅用作参考。'
    },

    'httpcheck.responselength': {
        info: '<code>响应长度</code>统计响应正文中的字符数。对于静态页面，这应该基本保持恒定。'
    },

    'httpcheck.status': {
        valueRange: "[0, 1]",
        info: '此图表验证 Web 服务器的响应。如果触发，每个状态维度的值都将为 <code>1</code>。 ' +
            '仅当满足所有约束时，维度 <code>success</code> 才为 <code>1</code>。 ' +
            '此图表对于警报或第三方应用程序最有用。'
    },

    // ------------------------------------------------------------------------
    // NETDATA

    'netdata.response_time': {
        info: 'netdata API 响应时间衡量 netdata 处理请求所需的时间。此时间包括从接收请求的第一个字节到发送其回复的最后一个字节的所有内容，因此它包括所有涉及的网络延迟（即通过慢速网络的客户端将影响这些指标）。'
    },

    'netdata.ebpf_threads': {
        info: '显示线程总数和活动线程数。有关线程的更多详细信息，请参阅<a href="https://learn.netdata.cloud/docs/agent/collectors/ebpf.plugin#ebpf-programs-configuration-options" target="_blank">官方文档</a>。'
    },

    'netdata.ebpf_load_methods': {
        info: '显示使用传统代码（独立二进制文件）或 <code>CO-RE（一次编译随处运行）</code>加载的线程数。'
    },

    // ------------------------------------------------------------------------
