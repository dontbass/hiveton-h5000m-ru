/* global NETDATA */

var netdataDashboard = window.netdataDashboard || {};

// Informational content for the various sections of the GUI (menus, sections, charts, etc.)

// ----------------------------------------------------------------------------
// Menus

netdataDashboard.menu = {
    'system': {
        title: '系统概览',
        icon: '<i class="fas fa-bookmark"></i>',
        info: '系统关键指标概览。'
    },

    'services': {
        title: 'systemd 服务',
        icon: '<i class="fas fa-cogs"></i>',
        info: 'systemd 服务的资源使用情况。'+
        'Netdata 通过 '+
        '<a href="https://en.wikipedia.org/wiki/Cgroups" target="_blank">cgroups</a> ' +
        '（容器使用的资源核算机制）监控所有 systemd 服务。'
    },

    'ap': {
        title: '无线接入点',
        icon: '<i class="fas fa-wifi"></i>',
        info: '系统中发现的无线接入点（AP模式的无线接口）的性能指标。'
    },

    'tc': {
        title: '服务质量',
        icon: '<i class="fas fa-globe"></i>',
        info: 'Netdata 使用其 ' +
            '<a href="https://github.com/netdata/netdata/blob/master/collectors/tc.plugin/tc-qos-helper.sh.in" target="_blank">tc-helper 插件</a>收集和可视化 <code>tc</code> 类的利用率。' +
            '如果您还使用 <a href="http://firehol.org/#fireqos" target="_blank">FireQOS</a> 来设置 QoS，' +
            'netdata 会自动收集接口和类名称。如果您的 QoS 配置包含开销计算，此处显示的值将包含这些开销（网络接口部分中报告的同一接口的总带宽将低于此处报告的总带宽）。' +
            'QoS 数据收集与接口相比可能有轻微的时间差异（QoS 数据收集使用 BASH 脚本，因此数据收集偏移几毫秒是正常的）。'
    },

    'net': {
        title: '网络接口',
        icon: '<i class="fas fa-sitemap"></i>',
        info: '<p>网络接口的性能<a href="https://www.kernel.org/doc/html/latest/networking/statistics.html" target="_blank">指标</a>。</p>'+
        '<p>Netdata 通过读取 <code>/proc/net/dev</code> 文件和 <code>/sys/class/net/</code> 目录来获取这些数据。</p>'
    },

    'Infiniband': {
        title: 'Infiniband 端口',
        icon: '<i class="fas fa-sitemap"></i>',
        info: '<p><a href="https://en.wikipedia.org/wiki/InfiniBand" target="_blank">Infiniband</a> 端口的性能和异常统计信息。'+
        '各个端口和硬件计数器的描述可以在 '+
        '<a href="https://community.mellanox.com/s/article/understanding-mlx5-linux-counters-and-status-parameters" target="_blank">Mellanox 知识库</a>中找到。'
    },

    'wireless': {
        title: '无线网络接口',
        icon: '<i class="fas fa-wifi"></i>',
        info: '无线网络接口的性能指标。'
    },

    'ip': {
        title: '网络协议栈',
        icon: '<i class="fas fa-cloud"></i>',
        info: function (os) {
            if (os === "linux")
                return '系统网络协议栈的指标。这些指标从 <code>/proc/net/netstat</code> 收集或通过附加 <code>kprobes</code> 到内核函数获取，适用于 IPv4 和 IPv6 流量，与内核网络协议栈的操作相关。';
            else
                return '系统网络协议栈的指标。';
        }
    },

    'ipv4': {
        title: 'IPv4 网络',
        icon: '<i class="fas fa-cloud"></i>',
        info: '系统 IPv4 协议栈的指标。' +
            '<a href="https://en.wikipedia.org/wiki/IPv4" target="_blank">互联网协议第 4 版 (IPv4)</a> 是互联网协议 (IP) 的第四个版本。'+
            '它是互联网中基于标准的互联网络方法的核心协议之一。IPv4 是用于分组交换网络的无连接协议。'+
            '它基于尽力而为的传递模型运行，不保证传递，也不保证正确的顺序或避免重复传递。'+
            '这些方面（包括数据完整性）由上层传输协议（如传输控制协议 (TCP)）处理。'
    },

    'ipv6': {
        title: 'IPv6 网络',
        icon: '<i class="fas fa-cloud"></i>',
        info: '系统 IPv6 协议栈的指标。<a href="https://en.wikipedia.org/wiki/IPv6" target="_blank">互联网协议第 6 版 (IPv6)</a> 是互联网协议 (IP) 的最新版本，是为网络上的计算机提供标识和定位系统并在互联网上路由流量的通信协议。IPv6 由互联网工程任务组 (IETF) 开发，以解决长期预期的 IPv4 地址耗尽问题。IPv6 旨在取代 IPv4。'
    },

    'sctp': {
        title: 'SCTP 网络',
        icon: '<i class="fas fa-cloud"></i>',
        info: '<p><a href="https://en.wikipedia.org/wiki/Stream_Control_Transmission_Protocol" target="_blank">流控制传输协议 (SCTP)</a> '+
        '是一种在传输层运行的计算机网络协议，其作用类似于流行的 TCP 和 UDP 协议。'+
        'SCTP 提供了 UDP 和 TCP 的一些特性：它像 UDP 一样面向消息，并像 TCP 一样通过拥塞控制确保可靠的按顺序消息传输。'+
        '它与这些协议的不同之处在于提供多宿主和冗余路径以提高弹性和可靠性。</p>'+
        '<p>Netdata 通过读取 <code>/proc/net/sctp/snmp</code> 文件来收集 SCTP 指标。</p>'
    },

    'ipvs': {
        title: 'IP 虚拟服务器',
        icon: '<i class="fas fa-eye"></i>',
        info: '<p><a href="http://www.linuxvirtualserver.org/software/ipvs.html" target="_blank">IPVS (IP 虚拟服务器)</a> '+
        '在 Linux 内核内实现传输层负载均衡，即所谓的第 4 层交换。'+
        '在主机上运行的 IPVS 充当真实服务器集群前端的负载均衡器，'+
        '它可以将基于 TCP/UDP 的服务请求定向到真实服务器，'+
        '并使真实服务器的服务在单个 IP 地址上显示为虚拟服务。</p>'+
        '<p>Netdata 通过读取 <code>/proc/net/ip_vs_stats</code> 收集摘要统计信息。'+
        '要显示服务及其服务器的统计信息，运行 <code>ipvsadm -Ln --stats</code> '+
        '或 <code>ipvsadm -Ln --rate</code> 查看速率统计信息。'+
        '有关详细信息，请参阅 <a href="https://linux.die.net/man/8/ipvsadm" target="_blank">ipvsadm(8)</a>。</p>'
    },

    'netfilter': {
